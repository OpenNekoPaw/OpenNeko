{
  "name": "@neko/local-metadata",
  "description": "Host-neutral local metadata ports and Node SQLite adapters for OpenNeko",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./resource-cache": "./src/resource-cache-contract.ts",
    "./node": "./src/node.ts",
    "./sqlite": "./src/sqlite/index.ts",
    "./testing": "./src/testing/index.ts",
    "./node-sqlite-local-metadata-store": "./src/node-sqlite-local-metadata-store.ts",
    "./node-workspace-identity": "./src/node-workspace-identity.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neko/content": "workspace:*",
    "@neko/entity-domain": "workspace:*",
    "@neko/media": "workspace:*",
    "@neko/search-domain": "workspace:*",
    "@neko/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.2"
  },
  "license": "AGPL-3.0-or-later"
}
