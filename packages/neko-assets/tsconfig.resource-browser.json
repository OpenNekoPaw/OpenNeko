{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals"],
    "noEmit": true
  },
  "include": [
    "src/global-library/**/*.ts",
    "src/global-library/**/*.tsx",
    "src/resource-browser/**/*.ts",
    "src/resource-browser/**/*.tsx"
  ]
}
