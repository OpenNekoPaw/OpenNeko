{
  "name": "@neko/chara-domain",
  "description": "Character domain runtime and host-neutral application services for OpenNeko",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts/index.ts",
    "./core": "./src/core/index.ts",
    "./application": "./src/application/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:run": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neko/content-domain": "workspace:*",
    "@neko/entity-domain": "workspace:*",
    "@neko/shared": "workspace:*",
    "@neko/screenplay-domain": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "6.0.3",
    "vitest": "4.1.2"
  },
  "license": "MIT"
}
