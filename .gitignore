# neko 本地工作区（缓存/本地配置，不跟踪）
# neko/ 是 Git 跟踪的项目事实目录，不要添加到 gitignore
.neko/
.serena/
.claude/

# 编辑器与 IDE
.vscode/*
!.vscode/settings.json
.idea/
.codex/
# Track repository quality and OpenSpec skills; ignore other local Codex state.
!.codex/
.codex/*
!.codex/skills/
.codex/skills/*
!.codex/skills/neko-quality-review/
!.codex/skills/neko-quality-review/**
!.codex/skills/openspec-propose/
!.codex/skills/openspec-propose/**
!.codex/skills/openspec-apply-change/
!.codex/skills/openspec-apply-change/**
!.codex/skills/openspec-archive-change/
!.codex/skills/openspec-archive-change/**
!.codex/skills/openspec-explore/
!.codex/skills/openspec-explore/**

# 依赖库与非 pnpm 锁文件
node_modules/
*.dll
*.so
*.dylib
bun.lock
bun.lockb
package-lock.json
npm-shrinkwrap.json
yarn.lock

# 构建产物（适用于一级和两级 package root）
dist/
out/
build/
.vite/
.dsh-development-runtime/
.dsh-runtime-stage/

# 测试与本地 fixture 产物；不得忽略源码中的 test/ 或 tests/
test-results/
playwright-report/
coverage/
.nyc_output/
.test-workspaces/

# 本地测试与评估运行证据（提交稳定摘要，不提交原始运行产物）
/reports/

# 本地生成产物（演示文稿、文档、媒体等）
/outputs/

# 缓存
.npm-cache/
.parcel-cache/
.cache/
.tmp/
__pycache__/
*.py[cod]

# 项目配置（敏感）
# CLAUDE.md

# 日志与缓存
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# 本地 smoke / 调试证据（PR 或文档需要的截图应显式放入目标文档目录）
smoke-artifacts/
debug-artifacts/

# TypeScript 增量编译产物
*.tsbuildinfo

# Native Node addon build outputs
*.node

# 环境变量（保留示例文件）
.env
.env.*
!.env.example

# 系统杂项
.DS_Store
