    },
    {
      "kind": "fixture",
      "sourceRef": "historical-tui:synthetic-workspaces",
      "desktopRefs": [
        "shared-fixtures/creative-planning-workspace",
        "shared-fixtures/media-library-workspace"
      ]
    },
    {
      "kind": "validator",
      "sourceRef": "historical-tui:artifact-validators",
      "desktopRefs": ["artifactChecks", "owning-domain validators"]
    },
    {
      "kind": "rubric",
      "sourceRef": "historical-tui:quality-rubrics",
