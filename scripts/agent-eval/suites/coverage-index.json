      "kind": "prompt-layer",
      "id": "schema",
      "disposition": "excluded",
      "deterministicValidation": {
        "command": "pnpm --dir packages/dsh-bridge exec vitest run src/product-system-prompt.test.ts src/index.test.ts",
        "reason": "The DSH bridge product protocol is a static fragment mounted after the locked standard preset; its content and exact registration are deterministic bridge contract checks."
      }
    },
