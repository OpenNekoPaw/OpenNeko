    {
      "kind": "prompt-layer",
      "id": "ephemeral",
      "disposition": "excluded",
      "deterministicValidation": {
        "command": "pnpm --dir packages/dsh-bridge exec vitest run src/index.test.ts",
        "reason": "Per-Conversation product context uses one exact DSH systemPrompt context registration and is covered by the bridge Session rebuild contract test."
      }
    },

    {
      "kind": "agent-runtime-capability",
      "id": "evaluation-platform",
      "disposition": "excluded",
      "deterministicValidation": {
        "command": "pnpm test:agent:eval",
        "reason": "Evaluation platform code is external test infrastructure and cannot change target Agent behavior by itself."
      }
    },
    {
      "kind": "agent-runtime-capability",
      "id": "dsh-standard-agent-loop",
      "disposition": "excluded",
      "deterministicValidation": {
        "command": "pnpm --dir packages/dsh-bridge run test -- --run",
        "reason": "The generic Agent loop is DSH-owned. OpenNeko verifies only ACP transport, typed bridge admission, and fail-visible diagnostics; it does not duplicate upstream loop behavior tests."
      }
    },
    {
      "kind": "agent-runtime-capability",
      "id": "dsh-standard-session-history",
      "disposition": "excluded",
      "deterministicValidation": {
        "command": "pnpm --dir packages/agent/runtime run test -- --run src/acp",
        "reason": "DSH owns session persistence and history replay semantics. OpenNeko tests exact Conversation-to-DSH Session binding and projection isolation, not a second session authority."
      }
    },
    {
      "kind": "agent-runtime-capability",
      "id": "dsh-standard-skill-runtime",
      "disposition": "excluded",
      "deterministicValidation": {
        "command": "pnpm --dir packages/dsh-bridge run test -- --run",
        "reason": "DSH owns Skill discovery, activation, and execution. OpenNeko retains Skill source/provenance projection and command gesture coverage only."
      }
    },
    {
      "kind": "agent-runtime-capability",
      "id": "dsh-standard-tool-scheduling",
      "disposition": "excluded",
      "deterministicValidation": {
        "command": "pnpm --dir packages/agent/runtime run test -- --run src/acp",
        "reason": "DSH owns generic Tool scheduling, progress, and standard cancellation. OpenNeko evaluates only domain Tool delegation, authorization, and artifact/job facts."
      }
    },
    {
      "kind": "agent-runtime-capability",
      "id": "dsh-standard-permission-presets",
      "disposition": "excluded",
      "deterministicValidation": {
        "command": "pnpm --dir packages/agent/contracts run test -- --run src/dsh-permission-host.test.ts",
        "reason": "DSH owns standard permission preset semantics. OpenNeko verifies sender-bound projection and explicit user selection without redefining plan/ask/auto or duplicating preset behavior."
      }
    },
