{
  "schema": "neko.agent-eval.scenario",
  "id": "reject-resource-traversal",
  "suiteId": "skill.skill-creator",
  "caseGroup": "boundary",
  "visibility": "public",
  "evidenceContract": {
    "userBehavior": "Preserve the native resource traversal rejection without correcting the path or writing outside the Skill package.",
    "canonicalPath": [
      "builtin skill-creator",
      "CreateSkill resource validation",
      "invalid-resource-path Tool result",
      "contained absence checks"
    ],
    "observables": [
      {
        "ref": "skill-facts",
        "kind": "runtime-fact",
        "description": "Builtin skill-creator injection facts.",
        "required": true
      },
      {
        "ref": "tool-facts",
        "kind": "runtime-fact",
        "description": "CreateSkill invalid-resource-path result facts.",
        "required": true
      },
      {
        "ref": "artifact-absence",
        "kind": "post-check",
        "description": "Neither the target package nor escaped resource exists.",
        "required": true
      }
    ],
    "expectedResult": "CreateSkill rejects the traversal resource path and writes no package or escaped file.",
    "expectedFailure": "A corrected path, fallback writer, different error, partial package, or escaped file fails."
  },
  "fixtureRefs": ["skill-artifact-workspace"],
  "runtimeProfileId": "canonical-default",
  "modelProfileIds": ["configured-default"],
  "steps": [
    {
      "id": "submit",
      "kind": "submit",
      "prompt": "$skill-creator Call CreateSkill exactly once with { layout: directory, skillMarkdown: \"---\\nname: eval-traversal-skill\\ndescription: Evaluate traversal rejection.\\n---\\n# Eval Traversal Skill\", resources: [{ path: ../escape.txt, content: MUST_NOT_ESCAPE }] }. The current Workspace Conversation owns the destination. Preserve the native failure; do not correct, retry, or use another writer."
    },
    {
      "id": "idle",
      "kind": "wait-for-idle",
      "timeoutMs": 120000
    }
  ],
  "assertions": [
    {
      "id": "skill",
      "kind": "skill",
      "identity": {
        "name": "skill-creator",
        "source": "builtin",
        "provenance": "builtin",
        "rootId": "builtin-skills",
        "relativePath": "skill-creator",
        "fingerprint": "sha256:6c2e87de899b872a0c16ffee63238b694d2a5b39e71b1be80c1688baa7a8089d"
      },
      "status": "injected",
      "evidenceRef": "skill-facts"
    },
    {
      "id": "tool",
      "kind": "tool-call",
      "name": "CreateSkill",
      "status": "error",
      "resultIncludes": {
        "code": "SKILL_AUTHORING_RESOURCE_PATH_INVALID"
      },
      "evidenceRef": "tool-facts"
    }
  ],
  "artifactChecks": [
    {
      "id": "target-absent",
      "kind": "file-absent",
      "evidenceRef": "artifact-absence",
      "path": ".agents/skills/eval-traversal-skill"
    },
    {
      "id": "escaped-file-absent",
      "kind": "file-absent",
      "evidenceRef": "artifact-absence",
      "path": ".agents/skills/escape.txt"
    }
  ],
  "budget": {
    "timeoutMs": 120000,
    "repetitions": 1
  }
}
