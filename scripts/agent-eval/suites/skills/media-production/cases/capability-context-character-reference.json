  "evidenceContract": {
    "userBehavior": "From an actual screenplay, compose separate creative, preparation, image-generation and candidate-selection Skills for one approved low-risk action, then observe the real result.",
    "canonicalPath": [
      "screenplay.fountain evidence",
      "builtin media-production Skill",
      "builtin media-preparation Skill",
      "builtin image Skill",
      "builtin media-selection Skill",
      "immutable DSH Tool snapshot",
      "Read source Tool call",
      "terminal GenerateImage Tool call",
      "durable generated artifact",
      "Agent review"
    ],
    "observables": [
      {
        "ref": "capability-facts",
        "kind": "runtime-fact",
        "description": "Skill receipt, source Read, terminal GenerateImage Tool result, durable artifact, and effective model.",
        "required": true
      }
    ],
    "expectedResult": "Media-production supplies source-grounded creative facts, media-preparation binds the image input, image performs the admitted generation call, and media-selection observes the returned artifact before the Agent describes the next action.",
    "expectedFailure": "One Skill impersonating the whole chain, skipping source evidence, substituting video or text, selecting from prompt metadata, or missing the terminal Tool result/artifact fails."
  },
  "fixtureRefs": ["creative-planning-workspace"],
  "runtimeProfileId": "ask-markdown",
  "modelProfileIds": ["configured-default"],
  "steps": [
    {
      "id": "submit",
      "kind": "submit",
      "prompt": "$media-production $media-preparation $image $media-selection 读取 @screenplay.fountain\n\n按各能力边界完成一个低风险 P0 单元：media-production 只提取 Mara、23:47、红伞和无头灯列车相关的已批准创意事实；media-preparation 编译一张 Mara 角色视觉参考图所需输入；image 仅在当前 Tool schema 支持时生成到 generated；media-selection 必须观察真实返回图像后再判断。不得导入资产库、修改项目或改用视频。若任一依赖不可用则在该边界明确 blocked，不要由其他 Skill 代替。"
    },
    {
      "id": "idle",
      "kind": "wait-for-idle",
      "timeoutMs": 600000
    }
  ],
