{
  "schema": "neko.agent-eval.scenario",
  "id": "illustration-technique-selection",
  "suiteId": "skill.media-production",
  "caseGroup": "regression",
  "visibility": "public",
  "evidenceContract": {
    "userBehavior": "Inspect an actual layered illustration and the current canonical Tool/Skill context, compare viable animation techniques, and select or block the next technique without defaulting to generative video or starting production.",
    "canonicalPath": [
      "station-illustration.svg evidence",
      "builtin media-production Skill",
      "immutable DSH Tool snapshot",
      "source Tool execution",
      "capability-aware technique decision"
    ],
    "observables": [
      {
        "ref": "selection-facts",
        "kind": "runtime-fact",
        "description": "Skill receipt, source read, technique comparison, forbidden Tool absence, effective model, and usage/context estimate.",
        "required": true
      }
    ],
    "expectedResult": "The Agent reads the layered SVG, checks current capabilities, compares generative video, layered 2D, frame animation, and compositing against the source and target, then selects only a declared path or reports the preferred path unavailable.",
    "expectedFailure": "Calling video or image generation, inventing support, or omitting source evidence fails."
  },
  "fixtureRefs": ["creative-planning-workspace"],
  "runtimeProfileId": "ask-markdown",
  "modelProfileIds": ["configured-default"],
  "steps": [
    {
      "id": "submit",
      "kind": "submit",
      "prompt": "$media-production 读取 @station-illustration.svg\n\n这是一个可分层的静态车站插画。以当前 turn 实际提供的工具和 Skill 目录为准，再比较生成式视频、分层 2D、逐帧动画与合成。目标是保留 Mara、红伞、无头灯列车和钟表的造型一致性，只让雨、伞和列车做克制运动。输出来源证据、各技术所需输入、当前 supported/degraded/unavailable 判断、选择或 blocked 结论及下一项可执行动作。不要假设未注册能力可用，不要生成图片或视频，不要预建节点图或固定工作流。"
    },
    {
      "id": "idle",
      "kind": "wait-for-idle",
      "timeoutMs": 240000
    }
  ],
