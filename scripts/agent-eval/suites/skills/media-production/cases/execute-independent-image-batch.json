  "evidenceContract": {
    "userBehavior": "Execute every independent image material in one ready production batch instead of stopping after the first result.",
    "canonicalPath": [
      "creator-established production-input batch",
      "builtin media-production orchestration",
      "builtin media-preparation batch compilation",
      "builtin image per-item method",
      "three same-turn openneko_generation calls",
      "three terminal Generation Jobs",
      "whole-batch result inspection",
      "terminal idle"
    ],
    "observables": [
      {
        "ref": "batch-generation-facts",
        "kind": "runtime-fact",
        "description": "One canonical turn with three distinct terminal image-generation Tool calls, three Canvas outputs, all required Skill receipts and an all-items result summary.",
        "required": true
      }
    ],
    "expectedResult": "The Agent keeps each material as one bounded image operation, emits three openneko_generation calls in the same task, waits for every result, checks all three, preserves their distinct item identities and stops before video or creator adoption.",
    "expectedFailure": "One generation followed by finalization, a single combined multi-material request, a missing batch item, a non-terminal Tool call, fewer than three Canvas outputs, automatic candidate adoption, or premature video generation fails."
  },
  "fixtureRefs": ["empty-workspace"],
  "runtimeProfileId": "execute",
  "modelProfileIds": ["nekoapi-image-purpose"],
  "steps": [
    {
      "id": "execute-ready-batch",
      "kind": "submit",
      "prompt": "$media-production $media-preparation $image 当前素材预处理表已有三个彼此独立、同优先级且无结果依赖的可执行图片素材：CHARACTER-ANCHOR（雨衣角色正背面轮廓设定，纯灰背景）、PROP-ANCHOR（关闭与打开的红伞物品设定，纯灰背景）、ENVIRONMENT-ANCHOR（空旷雨夜站台空间设定，无人物）。本次明确要求执行整个就绪批次，不进入视频：每项分别使用一次 image.generate，不要把三个素材合并为一张图或一个 prompt；在每个 request.metadata 中写入对应的 batchItemId；在同一任务内提交全部独立调用，等待全部真实结果，逐项检查是否与各自目标一致，再汇总三个素材结果。不要自动采用候选。"
    },
    { "id": "batch-idle", "kind": "wait-for-idle", "timeoutMs": 1200000 }
  ],
