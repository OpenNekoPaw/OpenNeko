{
  "schema": "neko.agent-eval.scenario",
  "id": "cancel-resume-recovery",
  "suiteId": "agent-runtime.workflow-controller",
  "caseGroup": "failure",
  "visibility": "public",
  "evidenceContract": {
    "userBehavior": "Queue two full-capability follow-ups, cancel the active turn without losing them, and immediately send the selected queued item before the other pending item.",
    "canonicalPath": [
      "message.submit",
      "message.submit:queued",
      "message.submit:queued",
      "message.cancel",
      "session.waitForIdle",
      "message.queue.send-now",
      "session.waitForIdle"
    ],
    "observables": [
      {
        "ref": "recovery-facts",
        "kind": "runtime-fact",
        "description": "Exact queue item identities, cancellation acceptance, paused queue state, selected send-now release, ordered Turns, and terminal idle facts.",
        "required": true
      }
    ],
    "expectedResult": "Cancellation pauses both pending items; send-now resumes the same Conversation, runs the selected item first, drains the remaining item, and reaches terminal idle without concurrent Turns.",
    "expectedFailure": "Rejected cancellation, lost pending input, unpaused cancellation, wrong-item release, reordered queued Turns, changed Conversation identity, concurrent execution, or busy terminal state fails."
  },
  "fixtureRefs": [
    "empty-workspace"
  ],
  "runtimeProfileId": "canonical-default",
  "modelProfileIds": [
    "configured-default"
  ],
  "steps": [
    {
      "id": "long-turn",
      "kind": "submit",
      "prompt": "Begin writing a 300-row five-column Markdown production table. Do not summarize."
    },
    {
      "id": "ordinary-follow-up",
      "kind": "queue",
      "afterStepId": "long-turn",
      "prompt": "Ordinary queued follow-up: respond with exactly one concise sentence."
    },
    {
      "id": "priority-follow-up",
      "kind": "queue",
      "afterStepId": "ordinary-follow-up",
      "prompt": "Priority queued recovery: respond with exactly one concise sentence."
    },
    {
      "id": "cancel",
      "kind": "cancel",
      "afterStepId": "priority-follow-up"
    },
    {
      "id": "cancelled-idle",
      "kind": "wait-for-idle",
      "timeoutMs": 120000
    },
    {
      "id": "send-priority-now",
      "kind": "send-queued-now",
      "queueStepId": "priority-follow-up"
    },
    {
      "id": "recovered-idle",
      "kind": "wait-for-idle",
      "timeoutMs": 120000
    }
  ],
  "assertions": [
    {
      "id": "cancelled",
      "kind": "cancellation",
      "stepId": "cancel",
      "accepted": true,
      "evidenceRef": "recovery-facts"
    },
    {
      "id": "ordinary-queued",
      "kind": "queue-state",
      "stepId": "ordinary-follow-up",
      "status": "queued",
      "minPending": 1,
      "evidenceRef": "recovery-facts"
    },
    {
      "id": "priority-queued",
      "kind": "queue-state",
      "stepId": "priority-follow-up",
      "status": "queued",
      "minPending": 2,
      "evidenceRef": "recovery-facts"
    },
    {
      "id": "paused",
      "kind": "queue-state",
      "stepId": "cancelled-idle",
      "status": "paused-after-cancel",
      "minPending": 2,
      "evidenceRef": "recovery-facts"
    },
    {
      "id": "priority-sent-now",
      "kind": "queue-state",
      "stepId": "send-priority-now",
      "status": "resumed-by-send-now",
      "queueStepId": "priority-follow-up",
      "evidenceRef": "recovery-facts"
    },
    {
      "id": "drained",
      "kind": "queue-state",
      "stepId": "recovered-idle",
      "status": "drained",
      "evidenceRef": "recovery-facts"
    },
    {
      "id": "ordered",
      "kind": "process-order",
      "events": [
        { "kind": "workflow-step", "stepId": "ordinary-follow-up", "method": "message.submit" },
        { "kind": "workflow-step", "stepId": "priority-follow-up", "method": "message.submit" },
        { "kind": "workflow-step", "stepId": "cancel", "method": "message.cancel" },
        { "kind": "workflow-step", "stepId": "send-priority-now", "method": "message.queue.send-now" },
        { "kind": "turn", "role": "user", "source": "user", "contentContains": "Priority queued recovery" },
        { "kind": "turn", "role": "user", "source": "user", "contentContains": "Ordinary queued follow-up" }
      ],
      "evidenceRef": "recovery-facts"
    },
    {
      "id": "terminal",
      "kind": "terminal-idle",
      "concerns": [
        "turnIdle",
        "continuationQueueIdle"
      ],
      "evidenceRef": "recovery-facts"
    },
    {
      "id": "answer",
      "kind": "final-answer",
      "mode": "non-empty",
      "evidenceRef": "recovery-facts"
    }
  ],
  "artifactChecks": [],
  "budget": {
    "timeoutMs": 240000,
    "repetitions": 1
  }
}
