{
  "schema": "neko.agent-eval.scenario",
  "id": "session-compact-continuation",
  "suiteId": "agent-runtime.workflow-controller",
  "caseGroup": "workflow",
  "visibility": "public",
  "evidenceContract": {
    "userBehavior": "Compact the exact active Conversation through its Session command catalog, then continue the same Conversation.",
    "canonicalPath": [
      "initial DSH Turn",
      "Session input catalog",
      "typed compact command invocation",
      "DSH Session compaction",
      "same-Conversation continuation turn"
    ],
    "observables": [
      {
        "ref": "compaction-facts",
        "kind": "runtime-fact",
        "description": "Exact command catalog receipt, compression result, stable Conversation identity, continuation Turn, and terminal DSH facts.",
        "required": true
      }
    ],
    "expectedResult": "The exact Session emits a compression result and accepts a subsequent durable turn under the same Conversation identity.",
    "expectedFailure": "Draft execution, ordinary-prompt fallback, another Conversation, missing compression result, lost continuation, or runtime error fails."
  },
  "fixtureRefs": ["empty-workspace"],
  "runtimeProfileId": "canonical-default",
  "modelProfileIds": ["configured-default"],
  "steps": [
    {
      "id": "context-turn",
      "kind": "submit",
      "prompt": "Provide a detailed but bounded explanation of why exact conversation identity matters for local Agent state."
    },
    { "id": "context-idle", "kind": "wait-for-idle", "timeoutMs": 180000 },
    {
      "id": "compact",
      "kind": "invoke-input",
      "trigger": "command",
      "name": "compact",
      "resultEvent": "compressionResult",
      "timeoutMs": 180000
    },
    {
      "id": "continue",
      "kind": "submit",
      "prompt": "Continue in this same conversation with one concise sentence after compaction."
    },
    { "id": "continued-idle", "kind": "wait-for-idle", "timeoutMs": 180000 }
  ],
  "assertions": [
    { "id": "runtime", "kind": "runtime-errors-empty", "evidenceRef": "compaction-facts" },
    {
      "id": "compact-command",
      "kind": "input-invocation",
      "stepId": "compact",
      "trigger": "command",
      "name": "compact",
      "status": "completed",
      "evidenceRef": "compaction-facts"
    },
    {
      "id": "order",
      "kind": "process-order",
      "events": [
        { "kind": "workflow-step", "stepId": "context-turn", "method": "message.submit" },
        { "kind": "workflow-step", "stepId": "compact", "method": "agent-input.invoke" },
        { "kind": "workflow-step", "stepId": "continue", "method": "message.submit" }
      ],
      "evidenceRef": "compaction-facts"
    },
    { "id": "terminal", "kind": "fully-idle", "evidenceRef": "compaction-facts" },
    {
      "id": "answer",
      "kind": "final-answer",
      "mode": "non-empty",
      "evidenceRef": "compaction-facts"
    }
  ],
  "artifactChecks": [],
  "budget": { "timeoutMs": 540000, "repetitions": 1 },
  "execution": {
    "evidenceLevel": "hidden-desktop",
    "resourceClass": "text",
    "protected": false,
    "startSurface": "workspace"
  }
}
