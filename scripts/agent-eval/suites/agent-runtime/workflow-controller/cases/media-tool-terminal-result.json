{
  "schema": "neko.agent-eval.scenario.v2",
  "id": "media-tool-terminal-result",
  "suiteId": "agent-runtime.workflow-controller",
  "caseGroup": "workflow",
  "visibility": "public",
  "evidenceContract": {
    "userBehavior": "Generate an image, wait for the terminal GenerateImage Tool result, inspect its generated-output resource through ReadImage, and continue the same Agent turn without a generic Task.",
    "canonicalPath": [
      "Desktop Agent input queue",
      "PiConversationRuntime",
      "flat image.generate domain-model snapshot",
      "GenerateImage Tool call",
      "Tool confirmation",
      "terminal Tool result",
      "generated-output ContentLocator",
      "ReadImage Tool call"
    ],
    "forbiddenFallback": [
      "generic TaskManager",
      "TaskRef",
      "task-result continuation",
      "mock media execution",
      "GetAsset for generated-output id",
      "implicit AssetLibrary membership",
      "SubAgent result lookup for media generation",
      "retired Host session owner",
      "model-authored provider or model id",
      "nested mediaModels routing"
    ],
    "observables": [
      {
        "ref": "tool-result-facts",
        "kind": "runtime-fact",
        "description": "GenerateImage and ReadImage Tool identities and terminal results, generated-output ContentLocator artifact digest/provenance/validator, forbidden legacy references, ordering, and terminal idle facts.",
        "required": true
      }
    ],
    "expectedResult": "GenerateImage remains active until it returns a generated resource, ReadImage inspects that resource successfully in the same Agent turn, and no generic Task or continuation participates.",
    "expectedFailure": "Missing terminal Tool result, generated resource evidence, ReadImage success, ordering, forbidden Task participation, or terminal idle evidence fails."
  },
  "fixtureRefs": ["empty-workspace"],
  "runtimeProfileId": "canonical-default",
  "modelProfileIds": ["configured-default"],
  "steps": [
    {
      "id": "generate",
      "kind": "submit",
      "prompt": "Generate one image of a cat playing with a red ball. Wait for the terminal GenerateImage Tool result, then pass its delivered generated-output ContentLocator unchanged to ReadImage before summarizing it. Do not use resourceRef, provider URL, localPath, data URL, base64, or GetAsset unless an explicit add-to-AssetLibrary operation has returned a separate AssetEntity id."
    },
    {
      "id": "confirm-generate-image",
      "kind": "confirm",
      "afterStepId": "generate",
      "toolName": "GenerateImage",
      "approved": true,
      "timeoutMs": 180000
    },
    { "id": "idle", "kind": "wait-for-idle", "timeoutMs": 300000 }
  ],
  "assertions": [
    { "id": "runtime", "kind": "runtime-errors-empty", "evidenceRef": "tool-result-facts" },
    {
