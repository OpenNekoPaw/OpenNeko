{
  "schema": "neko.agent-eval.scenario",
  "id": "media-tool-terminal-result",
  "suiteId": "agent-runtime.workflow-controller",
  "caseGroup": "workflow",
  "visibility": "public",
  "evidenceContract": {
    "userBehavior": "Generate an image through the Agent Tool path, inspect its durable output and Workspace Board delivery, then fail visibly in the same Conversation when a later turn has no image-generation binding.",
    "canonicalPath": [
      "Desktop Agent input queue",
      "PiConversationRuntime",
      "flat image.generate domain-model snapshot",
      "GenerateImage Tool call",
      "Tool confirmation",
      "terminal Tool result",
      "generated-output image_ref binding",
      "ReadImage short-reference Tool call",
      "exact Workspace Board delivery",
      "same-Conversation missing-binding Tool failure"
    ],
    "observables": [
      {
        "ref": "tool-result-facts",
        "kind": "runtime-fact",
        "description": "Effective model, Conversation/Turn/Tool identities, terminal Generation Job and generated-output evidence, Workspace Board target, missing-binding failure, and forbidden direct/fallback path facts.",
        "required": true
      }
    ],
    "expectedResult": "The first GenerateImage call reaches one exact Workspace Generation Job, durable artifact and Board target; the second call fails in the same Conversation before Job success because its exact image binding is unavailable.",
    "expectedFailure": "Missing effective configuration, Job/artifact/Board evidence, same-Conversation failure, or participation by direct generation, Canvas routing, alternate Job tools, provider/model fallback, generic Task or another Workspace fails."
  },
  "fixtureRefs": [
    "empty-workspace"
  ],
  "runtimeProfileId": "canonical-default",
  "modelProfileIds": [
    "configured-default"
  ],
  "steps": [
    {
      "id": "generate",
      "kind": "submit",
      "prompt": "Generate one image of a cat playing with a red ball. Wait for the terminal GenerateImage Tool result, then pass its delivered image_ref unchanged in ReadImage.image_refs before summarizing it. Do not construct a ContentLocator or use resourceRef, provider URL, localPath, data URL, base64, or GetAsset unless an explicit add-to-AssetLibrary operation has returned a separate AssetEntity id."
    },
    {
      "id": "confirm-generate-image",
      "kind": "confirm",
      "afterStepId": "generate",
      "toolName": "GenerateImage",
      "approved": true,
      "timeoutMs": 180000
    },
    {
      "id": "idle",
      "kind": "wait-for-idle",
      "timeoutMs": 300000
    },
    {
      "id": "missing-binding",
      "kind": "submit",
      "prompt": "Call GenerateImage exactly once for a blue square. Report its owner-qualified failure without using DirectGeneration, SubmitGenerationJob, Canvas, another provider/model, another Workspace, or a generic Task.",
      "modelProfileId": "nekoapi-chat-without-image-generation"
    },
    {
      "id": "confirm-missing-binding",
      "kind": "confirm",
      "afterStepId": "missing-binding",
      "toolName": "GenerateImage",
      "approved": true,
      "timeoutMs": 180000
    },
    {
      "id": "failure-idle",
      "kind": "wait-for-idle",
      "timeoutMs": 180000
    }
  ],
  "assertions": [
    {
      "id": "runtime",
      "kind": "runtime-errors-empty",
      "evidenceRef": "tool-result-facts"
    },
    {
      "id": "pi-runtime",
