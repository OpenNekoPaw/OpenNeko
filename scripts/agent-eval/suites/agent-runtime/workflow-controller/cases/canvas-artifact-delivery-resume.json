{
  "schema": "neko.agent-eval.scenario",
  "id": "canvas-artifact-delivery-resume",
  "suiteId": "agent-runtime.workflow-controller",
  "caseGroup": "failure",
  "visibility": "public",
  "evidenceContract": {
    "userBehavior": "Terminate the first Desktop Host after a valid Canvas delivery is queued, then let a second Host resume it.",
    "canonicalPath": [
      "Host A enqueue",
      "Host A termination",
      "LocalMetadata pending delivery",
      "Host B fenced takeover",
      "Canvas receipt"
    ],
    "observables": [
      {
        "ref": "recovery-facts",
        "kind": "runtime-fact",
        "description": "Stable delivery identity, claim epochs, single Canvas effect, projected receipt, and terminal idle facts.",
        "required": true
      }
    ],
    "expectedResult": "Host B resumes the same delivery identity, applies exactly one Canvas batch, and reaches terminal idle.",
    "expectedFailure": "Changed identity, stale commit success, duplicate content node, missing receipt, or non-idle recovery fails."
  },
  "fixtureRefs": ["document-image-workspace"],
  "runtimeProfileId": "canonical-default",
  "modelProfileIds": ["configured-default"],
  "steps": [
    {
      "id": "queue",
      "kind": "submit",
      "prompt": "Call openneko_document to read synthetic-document.epub and wait until its exact source reference Canvas delivery is queued."
    },
    {
      "id": "first-idle",
      "kind": "wait-for-idle",
      "timeoutMs": 240000
    },
    {
      "id": "resume-host",
      "kind": "resume",
      "conversationRef": "current"
    },
    {
      "id": "recover",
      "kind": "submit",
      "prompt": "Resume the same workspace delivery context and confirm it remains available."
    },
    {
      "id": "idle",
      "kind": "wait-for-idle",
      "timeoutMs": 240000
    }
  ],
  "assertions": [
    {
      "id": "recovered",
      "kind": "recovery",
      "resumeStepId": "resume-host",
      "submitStepId": "recover",
      "idleStepId": "idle",
      "evidenceRef": "recovery-facts"
    },
    {
      "id": "single-effect",
      "kind": "canvas-artifact-projection",
      "status": "projected",
      "targetKind": "workspace",
      "minNodeIds": 1,
      "sourceFingerprintRequired": true,
      "diagnosticsEmpty": true,
      "evidenceRef": "recovery-facts"
    },
    {
      "id": "terminal",
      "kind": "terminal-idle",
      "concerns": ["turnIdle", "continuationQueueIdle"],
      "evidenceRef": "recovery-facts"
    }
  ],
  "artifactChecks": [],
  "budget": {
    "timeoutMs": 240000,
    "repetitions": 1
  }
}
