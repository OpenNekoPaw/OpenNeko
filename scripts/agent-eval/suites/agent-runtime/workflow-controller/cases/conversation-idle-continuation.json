{
  "schema": "neko.agent-eval.scenario",
  "id": "conversation-idle-continuation",
  "suiteId": "agent-runtime.workflow-controller",
  "caseGroup": "regression",
  "visibility": "public",
  "evidenceContract": {
    "userBehavior": "Complete a Desktop turn, leave the same Conversation idle, and submit a second turn without reopening its exact DSH Session.",
    "canonicalPath": [
      "Desktop renderer/preload DSH Session bridge",
      "sender-bound Desktop DSH Session host",
      "exact Conversation-to-DSH Session binding",
      "public DSH Session submit",
      "DSH turn terminal projection",
      "idle interval",
      "public DSH Session submit",
      "same DSH Session turn lineage"
    ],
    "observables": [
      {
        "ref": "turn-facts",
        "kind": "runtime-fact",
        "description": "One exact Conversation/DSH Session binding remains authoritative across both durable turns with no runtime diagnostic.",
        "required": true
      }
    ],
    "expectedResult": "The second turn completes durably in the same open Desktop Conversation and exact DSH Session after the idle interval.",
    "expectedFailure": "A changed Conversation/DSH Session identity, runtime error, missing turn lineage, or non-idle terminal state fails visibly."
  },
  "fixtureRefs": [
    "empty-workspace"
  ],
  "runtimeProfileId": "canonical-default",
  "modelProfileIds": [
    "configured-default"
  ],
  "steps": [
    {
      "id": "first",
      "kind": "submit",
      "prompt": "Reply with one concise sentence confirming the first turn."
    },
    {
      "id": "first-idle",
      "kind": "wait-for-idle",
      "timeoutMs": 120000
    },
    {
      "id": "second",
      "kind": "submit",
      "prompt": "Reply with one concise sentence confirming continuation after the idle interval.",
      "delayMs": 35000
    },
    {
      "id": "second-idle",
      "kind": "wait-for-idle",
      "timeoutMs": 120000
    }
  ],
  "assertions": [
    {
      "id": "runtime",
      "kind": "runtime-errors-empty",
      "evidenceRef": "turn-facts"
    },
    {
      "id": "order",
      "kind": "process-order",
      "events": [
        {
          "kind": "workflow-step",
          "stepId": "first",
          "method": "message.submit"
        },
        {
          "kind": "workflow-step",
          "stepId": "second",
          "method": "message.submit"
        }
      ],
      "evidenceRef": "turn-facts"
    },
    {
      "id": "terminal",
      "kind": "terminal-idle",
      "concerns": [
        "turnIdle",
        "continuationQueueIdle"
      ],
      "evidenceRef": "turn-facts"
    },
    {
      "id": "answer",
      "kind": "final-answer",
      "mode": "non-empty",
      "evidenceRef": "turn-facts"
    }
  ],
  "artifactChecks": [],
  "budget": {
    "timeoutMs": 240000,
    "repetitions": 1
  }
}
