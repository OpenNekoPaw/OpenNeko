{
  "schema": "neko.agent-eval.scenario",
  "id": "detached-generation-job-observation",
  "suiteId": "agent-runtime.workflow-controller",
  "caseGroup": "workflow",
  "visibility": "public",
  "evidenceContract": {
    "userBehavior": "Ask the Agent to generate one image; the single official Generation Tool call remains active until the exact durable Job succeeds or fails.",
    "canonicalPath": [
      "public DSH Session submit",
      "DSH Session runtime",
      "openneko.generation submit Tool call",
      "GenerationJobCoordinator",
      "durable Generation Job store",
      "exact Generation Job observer",
      "terminal result locator projection"
    ],
    "observables": [
      {
        "ref": "detached-generation-facts",
        "kind": "runtime-fact",
        "description": "One official Generation Tool call; exact Generation Job identity; owning coordinator and observer; terminal result locator or explicit failure; and forbidden polling/fallback facts.",
        "required": true
      }
    ],
    "expectedResult": "The single openneko.generation submit Tool call completes only after the exact Job reaches succeeded and returns its canonical Workspace result locator.",
    "expectedFailure": "A pending Tool success, missing Job identity/result locator, model-authored polling, direct provider or generic Task participation, fallback, or hidden terminal Job failure fails."
  },
  "fixtureRefs": [
    "empty-workspace"
  ],
  "runtimeProfileId": "canonical-default",
  "modelProfileIds": [
    "configured-default"
  ],
  "steps": [
    {
      "id": "manage-detached-generation",
      "kind": "submit",
      "prompt": "Generate one image of a simple red circle on white. Wait for the official Generation Tool to finish and report the resulting artifact. Do not poll with additional Tool calls, do not use a generic Task, and do not choose a provider or model yourself."
    },
    {
      "id": "idle",
      "kind": "wait-for-idle",
      "timeoutMs": 300000
    }
  ],
  "assertions": [
    {
      "id": "runtime",
      "kind": "runtime-errors-empty",
      "evidenceRef": "detached-generation-facts"
    },
    {
      "id": "generation-reaches-terminal-success",
      "kind": "tool-call",
      "name": "openneko.generation",
      "status": "success",
      "resultIncludes": {
        "kind": "generation",
        "phase": "succeeded",
        "resultLocators": [
          {
            "file": {
              "authority": "workspace"
            }
          }
        ]
      },
      "evidenceRef": "detached-generation-facts"
    },
    {
      "id": "no-model-polling",
      "kind": "tool-call",
      "name": "DescribeGenerationJob",
      "status": "absent",
      "evidenceRef": "detached-generation-facts"
    },
    {
      "id": "order",
      "kind": "process-order",
      "events": [
        {
          "kind": "workflow-step",
          "stepId": "manage-detached-generation",
          "method": "message.submit"
        },
        {
          "kind": "tool",
          "name": "openneko.generation",
          "status": "success"
        }
      ],
      "evidenceRef": "detached-generation-facts"
    },
    {
      "id": "terminal",
      "kind": "terminal-idle",
      "concerns": [
        "turnIdle",
        "continuationQueueIdle"
      ],
      "evidenceRef": "detached-generation-facts"
    },
    {
      "id": "answer",
      "kind": "final-answer",
      "mode": "non-empty",
      "evidenceRef": "detached-generation-facts"
    }
  ],
  "artifactChecks": [],
  "budget": {
    "timeoutMs": 300000,
    "repetitions": 1
  }
}
