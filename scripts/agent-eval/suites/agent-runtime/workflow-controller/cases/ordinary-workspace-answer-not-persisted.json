{
  "schema": "neko.agent-eval.scenario",
  "id": "ordinary-workspace-answer-not-persisted",
  "suiteId": "agent-runtime.workflow-controller",
  "caseGroup": "regression",
  "visibility": "public",
  "evidenceContract": {
    "userBehavior": "Ask an ordinary informational question in a Workspace conversation without requesting a durable creative document.",
    "canonicalPath": [
      "Workspace-bound Desktop Agent turn",
      "ordinary Markdown final answer",
      "no DSH filesystem Tool call",
      "no Workspace file mutation"
    ],
    "observables": [
      {
        "ref": "ordinary-turn-facts",
        "kind": "runtime-fact",
        "description": "Ordinary final answer and terminal idle facts with no filesystem Tool call.",
        "required": true
      },
      {
        "ref": "generated-file-absence",
        "kind": "post-check",
        "description": "No file is added to the isolated empty Workspace.",
        "required": true
      }
    ],
    "expectedResult": "The Agent answers normally, the conversation retains the whole ordinary answer, and no filesystem Tool is called.",
    "expectedFailure": "Any read/write/edit call, automatic file persistence, an empty answer, or a non-idle turn fails."
  },
  "fixtureRefs": ["empty-workspace"],
  "runtimeProfileId": "canonical-default",
  "modelProfileIds": ["configured-default"],
  "steps": [
    {
      "id": "submit",
      "kind": "submit",
      "prompt": "Briefly explain the difference between a risk and an issue. This is an ordinary informational answer, not a request to create or save a durable document. Include the exact token ORDINARY_ONLY and finish with one plain-Markdown next action containing the exact token NEXT_ACTION_ORDINARY."
    },
    {
      "id": "idle",
      "kind": "wait-for-idle",
      "timeoutMs": 180000
    }
  ],
  "assertions": [
    {
      "id": "runtime",
      "kind": "runtime-errors-empty",
      "evidenceRef": "ordinary-turn-facts"
    },
    {
      "id": "answer",
      "kind": "final-answer",
      "mode": "contains",
      "text": ["ORDINARY_ONLY", "NEXT_ACTION_ORDINARY"],
      "evidenceRef": "ordinary-turn-facts"
    },
    {
      "id": "no-read",
      "kind": "tool-call",
      "name": "read",
      "status": "absent",
      "evidenceRef": "ordinary-turn-facts"
    },
    {
      "id": "no-write",
      "kind": "tool-call",
      "name": "write",
      "status": "absent",
      "evidenceRef": "ordinary-turn-facts"
    },
    {
      "id": "no-edit",
      "kind": "tool-call",
      "name": "edit",
      "status": "absent",
      "evidenceRef": "ordinary-turn-facts"
    },
    {
      "id": "terminal",
      "kind": "terminal-idle",
      "concerns": ["turnIdle", "continuationQueueIdle"],
      "evidenceRef": "ordinary-turn-facts"
    }
  ],
  "artifactChecks": [
    {
      "id": "no-generated-markdown",
      "kind": "file-absent",
      "evidenceRef": "generated-file-absence",
      "path": "neko/generated/file"
    }
  ],
  "budget": {
    "timeoutMs": 180000,
    "repetitions": 1
  }
}
