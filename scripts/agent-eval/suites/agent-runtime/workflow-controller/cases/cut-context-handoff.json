{
  "schema": "neko.agent-eval.scenario",
  "id": "cut-context-handoff",
  "suiteId": "agent-runtime.workflow-controller",
  "caseGroup": "regression",
  "visibility": "public",
  "evidenceContract": {
    "userBehavior": "Send one explicit current Cut Clip selection to an exact Desktop Agent conversation, then ask Agent to acknowledge the attached read-only editing context.",
    "canonicalPath": [
      "Cut document/session selection",
      "shared AgentContextPayload",
      "exact sender-bound Desktop Agent connection",
      "public Agent sendMessage bridge",
      "Agent context message enhancement",
      "Pi Conversation runtime and Pi Session",
      "terminal answer"
    ],
    "observables": [
      {
        "ref": "cut-context-facts",
        "kind": "runtime-fact",
        "description": "Exact Desktop turn identity, canonical Pi runtime path, Cut context summary in the Timeline, terminal marker, and zero forbidden-path facts.",
        "required": true
      }
    ],
    "expectedResult": "The exact Cut payload reaches the selected Agent conversation as visible context, participates in the Pi turn, and produces the requested terminal marker without changing the Cut document.",
    "expectedFailure": "Missing/stale context, wrong conversation identity, target inference, runtime diagnostics, or a missing marker fails visibly."
  },
  "fixtureRefs": [
    "empty-workspace"
  ],
  "runtimeProfileId": "canonical-default",
  "modelProfileIds": [
    "configured-default"
  ],
  "steps": [
    {
      "id": "submit-cut-context",
      "kind": "submit",
      "prompt": "Read only the attached Cut context. Reply with the selected Clip name and time range, then output CUT_CONTEXT_HANDOFF_OK on its own line.",
      "contextPayloads": [
        {
          "type": "cut-clip",
          "id": "cut:edits/qualification.otio:track:video-1:clip:clip-motion-a",
          "label": "Motion A with mixed audio",
          "summary": "Video Clip “Motion A with mixed audio” at 0.000s–2.000s.",
          "data": {
            "kind": "cut-clip-selection",
            "projectId": "project-fixture",
            "workspaceId": "workspace-fixture",
            "document": {
              "locator": {
                "kind": "workspace-file",
                "path": "edits/qualification.otio"
              },
              "sessionId": "cut-session-fixture"
            },
            "selection": {
              "kind": "clip",
              "trackId": "video-1",
              "trackKind": "Video",
              "clipId": "clip-motion-a",
              "timeRange": {
                "startSeconds": 0,
                "durationSeconds": 2
              },
              "media": {
                "targetUrl": "../media/motion-with-audio.mp4",
                "sourceStartSeconds": 0,
                "playbackRate": 1,
                "enabled": true,
                "audio": {
                  "muted": false,
                  "gain": 1,
                  "fadeInSeconds": 0,
                  "fadeOutSeconds": 0
                }
              }
            }
          }
        }
      ]
    },
    {
      "id": "idle",
      "kind": "wait-for-idle",
      "timeoutMs": 120000
    }
  ],
  "assertions": [
    {
      "id": "runtime",
      "kind": "runtime-errors-empty",
      "evidenceRef": "cut-context-facts"
    },
    {
      "id": "pi-runtime",
      "kind": "pi-runtime",
      "implementation": "pi-agent-core",
