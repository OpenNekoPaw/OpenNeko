          "status": "success"
        },
        {
          "kind": "tool",
          "name": "ObserveGenerationJob",
          "status": "success"
        }
      ],
      "evidenceRef": "generation-regenerate-facts"
    },
    {
      "id": "no-fallback",
      "kind": "no-fallback",
      "forbiddenRefs": [
        "summary-to-recipe",
        "generated-result-overwrite",
        "active-job-fallback",
        "latest-job-fallback",
        "generic-task-manager",
        "TaskRef",
        "AssetLibrary",
        "ImportAsset"
      ],
      "evidenceRef": "generation-regenerate-facts"
    },
    {
      "id": "terminal",
