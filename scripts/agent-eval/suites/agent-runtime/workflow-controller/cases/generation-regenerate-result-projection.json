{
  "schema": "neko.agent-eval.scenario.v2",
  "id": "generation-regenerate-result-projection",
  "suiteId": "agent-runtime.workflow-controller",
  "caseGroup": "regression",
  "visibility": "public",
  "evidenceContract": {
    "userBehavior": "Submit and observe one detached image Generation Job, then regenerate the successful result as a new submitted Job with an edited prompt instead of retrying or mutating the first result.",
    "canonicalPath": [
      "Desktop Agent input queue",
      "PiConversationRuntime",
      "SubmitGenerationJob Tool call",
      "Generation capability binding",
      "GenerationJobCoordinator",
      "versioned Generation Job store",
      "ObserveGenerationJob Tool call",
      "generated-output ContentLocator",
      "second SubmitGenerationJob Tool call",
      "new Generation Job identity"
    ],
    "forbiddenFallback": [
      "RetryGenerationJob for a successful result",
      "summary text used as recipe authority",
      "result locator overwritten in place",
      "active or latest Job fallback",
      "generic TaskManager",
      "AssetLibrary import"
    ],
    "observables": [
      {
        "ref": "generation-regenerate-facts",
        "kind": "runtime-fact",
        "description": "Two ordered Generation submissions, exact Job observation, generated-output validation, distinct result identity and absence of retry, summary-to-recipe and Asset fallbacks.",
        "required": true
      }
    ],
    "expectedResult": "The first successful Job remains immutable and observable; edit-and-generate submits a second Job with a new identity and generated-output locator while RetryGenerationJob is absent.",
    "expectedFailure": "Retrying a successful Job, reusing its identity or output revision, inferring recipe authority from the historical summary, missing generated-output evidence, or using a generic Task or Asset path fails."
  },
  "fixtureRefs": ["empty-workspace"],
  "runtimeProfileId": "canonical-default",
  "modelProfileIds": ["configured-default"],
  "steps": [
    {
      "id": "generate-and-regenerate",
      "kind": "submit",
      "prompt": "Submit one detached image Generation Job for a red paper kite on a white table. Observe the exact returned Job until success. Then edit the prompt to add a blue ribbon and regenerate by submitting a new Generation Job; do not call RetryGenerationJob for the successful result, do not overwrite the first Job or output, and do not reconstruct a recipe from summary text. Observe the second exact Job and report both Job identities and generated-output ContentLocators."
    },
    {
      "id": "idle",
      "kind": "wait-for-idle",
      "timeoutMs": 300000
    }
  ],
  "assertions": [
    {
      "id": "runtime",
      "kind": "runtime-errors-empty",
      "evidenceRef": "generation-regenerate-facts"
    },
    {
      "id": "submit-generation-job",
      "kind": "tool-call",
      "name": "SubmitGenerationJob",
      "status": "success",
      "resultIncludes": {
        "jobKind": "generation",
        "jobLifecycleOwner": "generation-job-coordinator",
        "phase": "pending",
        "revision": 1
      },
      "evidenceRef": "generation-regenerate-facts"
    },
    {
      "id": "observe-generation-job",
      "kind": "tool-call",
      "name": "ObserveGenerationJob",
      "status": "success",
      "resultIncludes": {
        "jobKind": "generation",
        "jobLifecycleOwner": "generation-job-coordinator"
      },
      "evidenceRef": "generation-regenerate-facts"
    },
    {
      "id": "generated-output",
      "kind": "artifact",
      "artifactKind": "generated-asset",
      "provenanceSource": "generated-output",
      "validatorId": "content-locator",
      "contentLocatorKind": "generated-output",
      "validatorStatus": "valid",
      "evidenceRef": "generation-regenerate-facts"
    },
    {
      "id": "no-retry-success",
      "kind": "tool-call",
      "name": "RetryGenerationJob",
      "status": "absent",
      "evidenceRef": "generation-regenerate-facts"
    },
    {
      "id": "canonical-order",
      "kind": "process-order",
      "events": [
        {
          "kind": "workflow-step",
          "stepId": "generate-and-regenerate",
