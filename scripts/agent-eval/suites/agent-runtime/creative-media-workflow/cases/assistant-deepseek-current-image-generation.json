{
  "schema": "neko.agent-eval.scenario",
  "id": "assistant-deepseek-current-image-generation",
  "suiteId": "agent-runtime.creative-media-workflow",
  "caseGroup": "regression",
  "visibility": "public",
  "evidenceContract": {
    "userBehavior": "Start a new Assistant conversation with DeepSeek and generate one new image for the current request instead of inspecting a historical Generation Job or generated file.",
    "canonicalPath": [
      "unbound Entry Draft with explicit DeepSeek chat and image.generate purpose binding",
      "Assistant binding materialization",
      "current message.submit workflow step",
      "current terminal GenerateImage Tool call",
      "Assistant Generation owner",
      "current generated-output ContentLocator",
      "terminal idle"
    ],
    "observables": [
      {
        "ref": "deepseek-generation-facts",
        "kind": "runtime-fact",
        "description": "Exact DeepSeek and image-generation model binding, current ordered GenerateImage result, generated-output identity, forbidden historical Job and file-inspection Tool absence, and terminal idle facts from the canonical Desktop owner.",
        "required": true
      }
    ],
    "expectedResult": "The new Assistant Draft keeps its explicit image.generate binding, invokes GenerateImage after the current submit, and returns a valid generated-output artifact without inspecting historical Jobs or files.",
    "expectedFailure": "A missing current GenerateImage result, historical DescribeGenerationJob or ObserveGenerationJob use, directory or file scanning, ReadImage substitution, invalid generated-output identity, runtime error, or non-idle completion fails visibly."
  },
  "fixtureRefs": ["empty-workspace"],
  "runtimeProfileId": "canonical-default",
  "modelProfileIds": ["deepseek-image-purpose"],
  "steps": [
    {
      "id": "generate-current",
      "kind": "submit",
      "prompt": "$image Generate one new image for this request: a cobalt-blue ceramic cup centered on a plain white studio table. Do not inspect or reuse any historical Generation Job or generated file, and do not perform visual QA. Wait for the current GenerateImage result and report its generated-output ContentLocator."
    },
    { "id": "current-idle", "kind": "wait-for-idle", "timeoutMs": 300000 }
  ],
  "assertions": [
    {
      "id": "runtime",
      "kind": "runtime-errors-empty",
      "evidenceRef": "deepseek-generation-facts"
    },
    {
      "id": "binding",
      "kind": "interaction-binding",
      "initialPhase": "draft",
      "initialBindingKind": "unbound",
      "finalPhase": "session",
      "finalBindingKind": "assistant",
      "conversationCreated": true,
      "evidenceRef": "deepseek-generation-facts"
    },
    {
      "id": "current-generation-order",
      "kind": "process-order",
      "events": [
        { "kind": "workflow-step", "stepId": "generate-current", "method": "message.submit" },
        { "kind": "tool", "name": "GenerateImage", "status": "success" }
      ],
      "evidenceRef": "deepseek-generation-facts"
    },
    {
      "id": "current-generation",
      "kind": "tool-call",
      "name": "GenerateImage",
      "status": "success",
      "resultIncludes": {
        "status": "completed",
        "jobKind": "generation",
        "jobLifecycleOwner": "generation-job-coordinator",
        "outputs": [{ "type": "image", "contentLocator": { "kind": "generated-output" } }],
        "routedTo": { "provider": "nekoapi-media", "model": "gpt-image-2" }
      },
      "evidenceRef": "deepseek-generation-facts"
    },
    {
      "id": "no-historical-describe",
      "kind": "tool-call",
      "name": "DescribeGenerationJob",
      "status": "absent",
      "evidenceRef": "deepseek-generation-facts"
    },
    {
      "id": "no-historical-observe",
      "kind": "tool-call",
      "name": "ObserveGenerationJob",
      "status": "absent",
      "evidenceRef": "deepseek-generation-facts"
    },
    {
      "id": "no-directory-scan",
      "kind": "tool-call",
      "name": "ListDirectory",
      "status": "absent",
      "evidenceRef": "deepseek-generation-facts"
    },
    {
      "id": "no-content-search",
      "kind": "tool-call",
      "name": "Grep",
      "status": "absent",
      "evidenceRef": "deepseek-generation-facts"
    },
    {
      "id": "no-file-read",
      "kind": "tool-call",
      "name": "Read",
      "status": "absent",
      "evidenceRef": "deepseek-generation-facts"
    },
    {
      "id": "no-visual-qa-substitute",
      "kind": "tool-call",
      "name": "ReadImage",
      "status": "absent",
      "evidenceRef": "deepseek-generation-facts"
    },
    {
      "id": "terminal",
      "kind": "terminal-idle",
      "concerns": ["turnIdle", "continuationQueueIdle"],
      "evidenceRef": "deepseek-generation-facts"
    }
  ],
  "artifactChecks": [],
  "budget": { "timeoutMs": 300000, "repetitions": 1 },
  "execution": {
    "evidenceLevel": "hidden-desktop",
    "resourceClass": "media",
    "protected": false,
    "startSurface": "entry"
  }
}
