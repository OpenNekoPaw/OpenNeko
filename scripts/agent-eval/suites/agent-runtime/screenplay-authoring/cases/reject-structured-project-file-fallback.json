{
  "schema": "neko.agent-eval.scenario",
  "id": "reject-structured-project-file-fallback",
  "suiteId": "agent-runtime.screenplay-authoring",
  "caseGroup": "failure",
  "visibility": "public",
  "evidenceContract": {
    "userBehavior": "Query exact invalid Canvas and Cut project fixtures through their owning structured capabilities and observe local codec failures.",
    "canonicalPath": [
      "public DSH Session submit",
      "Canvas structured query capability",
      "Canvas owning codec rejection",
      "Cut structured query capability",
      "Cut owning codec rejection"
    ],
    "observables": [
      {
        "ref": "structured-project-no-fallback-facts",
        "kind": "runtime-fact",
        "description": "Exact failed Canvas/Cut query calls, absent generic read/write/bash calls and idle terminal state.",
        "required": true
      },
      {
        "ref": "structured-project-files",
        "kind": "post-check",
        "description": "Byte-identical protected project fixture files after both owning-codec failures.",
        "required": true
      }
    ],
    "expectedResult": "Both owning capabilities fail locally on invalid project bytes, no generic file or shell operation runs and the Conversation reaches idle.",
    "expectedFailure": "A successful structured query, any Read/Write/Bash call, changed project file or global runtime failure fails the case."
  },
  "fixtureRefs": ["screenplay-authoring-workspace"],
  "runtimeProfileId": "canonical-default",
  "modelProfileIds": ["configured-default"],
  "steps": [
    {
      "id": "submit",
      "kind": "submit",
      "prompt": "先调用 canvas_list_nodes 查询精确文件 project.nkc；它应因无效 Canvas codec 内容而失败。然后调用 cut_query_timeline 查询精确文件 timeline.otio；它也应因无效 OTIO codec 内容而失败。两次失败后只回复 STRUCTURED_PROJECT_NO_FILE_FALLBACK。不得调用 read、write、bash 或其他原始文件与 shell 工具，不得改用其他路径。"
    },
    { "id": "idle", "kind": "wait-for-idle", "timeoutMs": 180000 }
  ],
  "assertions": [
    {
      "id": "idle",
      "kind": "fully-idle",
      "evidenceRef": "structured-project-no-fallback-facts"
    },
    {
      "id": "canvas-codec-rejected",
      "kind": "tool-call",
      "name": "canvas_list_nodes",
      "status": "error",
      "expectedArguments": { "document_path": "project.nkc" },
      "evidenceRef": "structured-project-no-fallback-facts"
    },
    {
      "id": "cut-codec-rejected",
      "kind": "tool-call",
      "name": "cut_query_timeline",
      "status": "error",
      "expectedArguments": { "document_path": "timeline.otio" },
      "evidenceRef": "structured-project-no-fallback-facts"
    },
    {
      "id": "no-read-fallback",
      "kind": "tool-call",
      "name": "read",
      "status": "absent",
      "evidenceRef": "structured-project-no-fallback-facts"
    },
    {
      "id": "no-write-fallback",
      "kind": "tool-call",
      "name": "write",
      "status": "absent",
      "evidenceRef": "structured-project-no-fallback-facts"
    },
    {
      "id": "no-bash-fallback",
      "kind": "tool-call",
      "name": "bash",
      "status": "absent",
      "evidenceRef": "structured-project-no-fallback-facts"
    },
    {
      "id": "answer",
      "kind": "final-answer",
      "mode": "contains",
      "text": ["STRUCTURED_PROJECT_NO_FILE_FALLBACK"],
      "evidenceRef": "structured-project-no-fallback-facts"
    }
  ],
