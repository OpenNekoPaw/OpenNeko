    "lifecycleChecks": ["composer-focus", "graceful-close"]
  },
  "evidenceContract": {
    "userBehavior": "Read one existing Fountain file, freshness-replace it through the native Workspace file path, then create one new Fountain file.",
    "canonicalPath": [
      "Desktop Agent public composer",
      "exact DSH Session",
      "DSH native read",
      "DSH filesystem observation",
      "DSH native write",
      "atomic observed replacement",
      "DSH native write",
      "atomic create"
    ],
    "observables": [
      {
        "ref": "native-fountain-authoring-facts",
        "kind": "runtime-fact",
        "description": "Exact native read and write identities, observation-protected update, create result, absent retired screenplay Tools and terminal state.",
        "required": true
      },
      {
        "ref": "screenplay-files",
        "kind": "post-check",
        "description": "Exact final UTF-8 Fountain bytes in the mutable Workspace fixture.",
        "required": true
      }
    ],
    "expectedResult": "The existing screenplay.fountain is updated after DSH observes it and ai-draft.fountain is created through the same native filesystem path.",
    "expectedFailure": "Missing DSH read observation, a retired screenplay Tool, wrong operation, overwrite race, wrong bytes or non-terminal state fails visibly."
  },
  "fixtureRefs": ["screenplay-authoring-workspace"],
  "runtimeProfileId": "canonical-default",
  "modelProfileIds": ["configured-default"],
  "steps": [
    {
      "id": "submit",
      "kind": "submit",
      "prompt": "这是明确的文件写入请求。先调用 DSH 原生 read 读取 screenplay.fountain。然后调用 DSH 原生 write，把 screenplay.fountain 完整替换为以下精确文本：.INT. KITCHEN - NIGHT\\n\\n@MARA\\nWe leave now.\\n。成功后，再调用 write 创建 ai-draft.fountain，内容精确为：.INT. ROOM - NIGHT\\n\\n@NEKO\\nHello.\\n。全部成功后只回复 NATIVE_FOUNTAIN_AUTHORING_OK。不得调用 InspectScreenplay、CreateScreenplayDraft 或 ReplaceScreenplayScene。"
    },
    { "id": "idle", "kind": "wait-for-idle", "timeoutMs": 180000 }
  ],
  "assertions": [
