{
  "schema": "neko.agent-eval.scenario",
  "id": "reject-protected-project-raw-access",
  "suiteId": "agent-runtime.screenplay-authoring",
  "caseGroup": "failure",
  "visibility": "public",
  "evidenceContract": {
    "userBehavior": "Attempt raw reads and approved raw writes against exact Canvas and Cut project documents and observe local denials.",
    "canonicalPath": [
      "public DSH Session submit",
      "DSH native read pre-execution policy",
      "Canvas .nkc protected-project rejection",
      "DSH native read pre-execution policy",
      "Cut .otio protected-project rejection",
      "DSH native write pre-execution policy rejection"
    ],
    "observables": [
      {
        "ref": "protected-project-boundary-facts",
        "kind": "runtime-fact",
        "description": "Exact failed native read and write calls for .nkc/.otio, absent retired screenplay Tools, absent shell fallback and idle terminal state.",
        "required": true
      },
      {
        "ref": "protected-project-files",
        "kind": "post-check",
        "description": "Byte-identical protected project fixture files after every denied raw operation.",
        "required": true
      }
    ],
    "expectedResult": "All raw .nkc/.otio reads and writes fail with the owning Canvas/Cut boundary, files remain unchanged and the Conversation reaches idle.",
    "expectedFailure": "Raw bytes, a successful write, shell fallback, retired screenplay Tool, changed project file or global runtime failure fails the case."
  },
  "fixtureRefs": ["screenplay-authoring-workspace"],
  "runtimeProfileId": "canonical-default",
  "modelProfileIds": ["configured-default"],
  "steps": [
    {
      "id": "submit",
      "kind": "submit",
      "prompt": "依次调用 DSH 原生 read 读取 project.nkc 和 timeline.otio；两次都应被受保护项目边界拒绝。然后调用 DSH 原生 write 尝试把 project.nkc 和 timeline.otio 分别写成精确内容 {}\\n；两次也都应被拒绝。完成后只回复 PROTECTED_PROJECT_RAW_ACCESS_REJECTED。不得调用 shell、InspectScreenplay、CreateScreenplayDraft 或 ReplaceScreenplayScene，也不得改用其他原始文件路径。"
    },
    { "id": "idle", "kind": "wait-for-idle", "timeoutMs": 180000 }
  ],
  "assertions": [
    { "id": "idle", "kind": "fully-idle", "evidenceRef": "protected-project-boundary-facts" },
    {
      "id": "read-canvas-denied",
      "kind": "tool-call",
      "name": "read",
      "status": "error",
      "expectedArguments": { "file_path": "project.nkc" },
      "evidenceRef": "protected-project-boundary-facts"
    },
    {
      "id": "read-cut-denied",
      "kind": "tool-call",
      "name": "read",
      "status": "error",
      "expectedArguments": { "file_path": "timeline.otio" },
      "evidenceRef": "protected-project-boundary-facts"
    },
    {
      "id": "write-canvas-denied",
      "kind": "tool-call",
      "name": "write",
      "status": "error",
      "expectedArguments": { "file_path": "project.nkc", "content": "{}\n" },
      "evidenceRef": "protected-project-boundary-facts"
    },
    {
      "id": "write-cut-denied",
      "kind": "tool-call",
      "name": "write",
      "status": "error",
      "expectedArguments": { "file_path": "timeline.otio", "content": "{}\n" },
      "evidenceRef": "protected-project-boundary-facts"
    },
    {
      "id": "no-bash",
      "kind": "tool-call",
      "name": "bash",
      "status": "absent",
      "evidenceRef": "protected-project-boundary-facts"
    },
    {
      "id": "no-inspect-screenplay",
      "kind": "tool-call",
      "name": "InspectScreenplay",
      "status": "absent",
      "evidenceRef": "protected-project-boundary-facts"
    },
    {
      "id": "no-create-screenplay-draft",
      "kind": "tool-call",
      "name": "CreateScreenplayDraft",
      "status": "absent",
      "evidenceRef": "protected-project-boundary-facts"
    },
    {
      "id": "no-replace-screenplay-scene",
      "kind": "tool-call",
      "name": "ReplaceScreenplayScene",
      "status": "absent",
      "evidenceRef": "protected-project-boundary-facts"
    },
    {
      "id": "answer",
      "kind": "final-answer",
      "mode": "contains",
      "text": ["PROTECTED_PROJECT_RAW_ACCESS_REJECTED"],
      "evidenceRef": "protected-project-boundary-facts"
    }
  ],
  "artifactChecks": [
