{
  "schema": "neko.agent-eval.scenario",
  "id": "document-image-native-delivery",
  "suiteId": "agent-runtime.stream-delivery",
  "caseGroup": "regression",
  "visibility": "public",
  "evidenceContract": {
    "userBehavior": "Read two committed synthetic EPUB images through Conversation-scoped refs and deliver one bounded contact sheet to the native multimodal Pi turn.",
    "canonicalPath": [
      "Desktop Agent input queue",
      "Pi Agent Tool schema",
      "attached document input_ref",
      "ReadDocument image_ref projection",
      "ReadImage canonical reference resolution",
      "ReadImage direct document-entry content read",
      "Host labeled contact-sheet composition",
      "native multimodal Pi turn",
      "conversation projection store",
      "Desktop locator-backed resource display projector",
      "Desktop OpenNeko resource registry",
      "package-owned Agent document image card",
      "terminal answer"
    ],
    "observables": [
      {
        "ref": "document-image-facts",
        "kind": "runtime-fact",
        "description": "Pi identity, ordered successful Tool calls, normalized matching document-entry results, authorized redacted Agent Webview resource projection, and terminal native-image answer facts.",
        "required": true
      }
    ],
    "expectedResult": "ReadDocument returns two synthetic page image_refs, ReadImage resolves both to their canonical identities, Desktop authorizes document-entry image display without replacing the locator, and the native multimodal turn identifies both contact-sheet tiles before the final marker.",
    "expectedFailure": "Missing or conflicting entry identity, whole-archive or fabricated-ref loading, denied display authorization, URL/path identity substitution, failed Tool execution, runtime diagnostics, or a missing visual answer fails visibly."
  },
  "fixtureRefs": ["document-image-workspace"],
  "runtimeProfileId": "markdown",
  "modelProfileIds": ["configured-default"],
  "steps": [
    {
      "id": "submit",
      "kind": "submit",
      "prompt": "严格执行两步文档图片读取：先使用附件中显示的 input_ref 调用 ReadDocument，mode=content、include_images=true；再从返回结果中选择前两个 image_ref，调用 ReadImage，image_refs 只包含这两个短引用且 analysis=storyboard。不要构造 locator、路径、MIME 或文档位置，不要传整本 EPUB。根据 ReadImage 交付的原生 contact sheet，按 tile 1、tile 2 顺序写出两个黑色区域里的四字符代码，再简短说明两页主色，最后单独输出 DOCUMENT_IMAGE_NATIVE_OK。",
      "contextPayloads": [
        {
          "type": "file",
          "id": "file:synthetic-document.epub",
          "label": "synthetic-document.epub",
          "summary": "Synthetic EPUB document",
          "data": {
            "kind": "authorized-content-reference",
            "locator": {
              "kind": "workspace-file",
              "path": "synthetic-document.epub"
            },
            "mediaType": "document"
          }
        }
      ]
    },
    {
      "id": "idle",
      "kind": "wait-for-idle",
      "timeoutMs": 180000
    }
  ],
  "assertions": [
