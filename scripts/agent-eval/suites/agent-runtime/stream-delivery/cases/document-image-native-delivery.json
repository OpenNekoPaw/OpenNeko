{
  "schema": "neko.agent-eval.scenario",
  "id": "document-image-native-delivery",
  "suiteId": "agent-runtime.stream-delivery",
  "caseGroup": "regression",
  "visibility": "public",
  "evidenceContract": {
    "userBehavior": "Read two committed synthetic EPUB images through canonical document-entry contentLocators and deliver one bounded contact sheet to the native multimodal Pi turn.",
    "canonicalPath": [
      "Desktop Agent input queue",
      "Pi Agent Tool schema",
      "ReadDocument imageInfo document-entry contentLocator",
      "ReadImage canonical content locator validation",
      "ReadImage direct document-entry content read",
      "Host labeled contact-sheet composition",
      "native multimodal Pi turn",
      "conversation projection store",
      "Desktop locator-backed resource display projector",
      "Desktop OpenNeko resource registry",
      "package-owned Agent document image card",
      "terminal answer"
    ],
    "observables": [
      {
        "ref": "document-image-facts",
        "kind": "runtime-fact",
        "description": "Pi identity, ordered successful Tool calls, normalized matching document-entry results, authorized redacted Agent Webview resource projection, and terminal native-image answer facts.",
        "required": true
      }
    ],
    "expectedResult": "ReadDocument returns two synthetic page contentLocators, ReadImage preserves and directly reads both identities, Desktop authorizes document-entry image display without replacing the locator, and the native multimodal turn identifies both contact-sheet tiles before the final marker.",
    "expectedFailure": "Missing or conflicting entry identity, whole-archive or fabricated-ref loading, denied display authorization, URL/path identity substitution, failed Tool execution, runtime diagnostics, or a missing visual answer fails visibly."
  },
  "fixtureRefs": [
    "document-image-workspace"
  ],
  "runtimeProfileId": "markdown",
  "modelProfileIds": [
    "configured-default"
  ],
  "steps": [
    {
      "id": "submit",
      "kind": "submit",
      "prompt": "严格执行两步文档图片读取：先调用 ReadDocument 一次，以 content mode 读取工作区相对路径 synthetic-document.epub，include_images=true、max_images=2；再把返回的 imageInfo[0] 和 imageInfo[1] 原样作为 ReadImage.images[0] 和 images[1]，保留每项 contentLocator 的 kind、source.path 和 entryPath，analysis=storyboard、mode=metadata、max_images=2。不要改写 contentLocator，不要传 resourceRef、整本 EPUB、裸 entryPath、缓存路径或临时路径。根据 ReadImage 交付的原生 contact sheet，按 tile 1、tile 2 顺序写出两个黑色区域里的四字符代码，再简短说明两页主色，最后单独输出 DOCUMENT_IMAGE_NATIVE_OK。"
    },
    {
      "id": "idle",
      "kind": "wait-for-idle",
      "timeoutMs": 180000
    }
  ],
  "assertions": [
    {
      "id": "runtime",
