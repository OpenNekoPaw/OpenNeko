  "evidenceContract": {
    "userBehavior": "Review a completed creative concept and use an unqualified continuation turn to perform the single recommended next step from the same Workspace context.",
    "canonicalPath": [
      "source-grounded creative concept",
      "compact end-to-end roadmap",
      "one recommended next action",
      "same-Workspace continuation",
      "updateable Markdown storyboard table"
    ],
    "observables": [
      {
        "ref": "workspace-creative-continue-facts",
        "kind": "runtime-fact",
        "description": "Two canonical turns, current Workspace reuse, continuation into the recommended storyboard step, and absent generation side effects.",
        "required": true
      }
    ],
    "expectedResult": "The first turn creates the source-specific PV concept, a compact production roadmap and exactly one next action to turn the current reviewed concept into a Markdown storyboard. The bare continuation performs that action from the existing artifact without restarting source analysis, emits an updateable scene/shot table with stable local row labels, and recommends one following preparation action.",
    "expectedFailure": "Asking what continue means, repeating the concept or source analysis, skipping directly to generation, creating approval or workflow-state objects, replacing the Markdown table with a new structured domain model, or offering multiple next actions fails."
  },
