          "id": "base",
          "source": "base"
        },
        {
          "id": "skill:storyboard",
          "source": "skill.injection"
        }
      ],
      "evidenceRef": "prompt-facts"
    },
    {
      "id": "answer",
      "kind": "final-answer",
      "mode": "non-empty",
      "evidenceRef": "prompt-facts"
    }
  ],
  "artifactChecks": [],
  "budget": {
    "timeoutMs": 180000,
    "repetitions": 1
  }
