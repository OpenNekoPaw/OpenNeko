{
  "schema": "neko.agent-eval.scenario",
  "id": "base-and-skill-fragments",
  "suiteId": "agent-runtime.prompt-composition",
  "caseGroup": "canonical",
  "visibility": "public",
  "evidenceContract": {
    "userBehavior": "Run an explicit Skill turn with the canonical base and Skill prompt fragments actually composed.",
    "canonicalPath": [
      "Desktop Agent runtime assembly",
      "base prompt fragment",
      "explicit storyboard activation",
      "skill.injection fragment",
      "assistant output"
    ],
    "observables": [
      {
        "ref": "prompt-facts",
        "kind": "runtime-fact",
        "description": "Secret-free prompt fragment identities, order, sources, and hashes.",
        "required": true
      }
    ],
    "expectedResult": "Facts include the base and canonical storyboard Skill fragments without exposing their content.",
    "expectedFailure": "Missing base/Skill fragment or incomplete composition facts fails."
  },
  "fixtureRefs": [
    "empty-workspace"
  ],
  "runtimeProfileId": "markdown",
  "modelProfileIds": [
    "configured-default"
  ],
  "steps": [
    {
      "id": "submit",
      "kind": "submit",
      "prompt": "$storyboard 为夜雨车站的一次推门动作给出一个镜头建议。"
