  "evidenceContract": {
    "userBehavior": "Request an AI-ready keyframe handoff in ordinary language without naming any Skill.",
    "canonicalPath": [
      "OpenNeko product prompt",
      "implicit media-production selection",
      "implicit media-preparation selection",
      "implicit image selection",
      "dependency-ready handoff or exact blocked binding"
    ],
    "observables": [
      {
        "ref": "implicit-handoff-facts",
        "kind": "runtime-fact",
        "description": "Implicit Skill receipts, screenplay evidence, and a bounded production handoff.",
        "required": true
      }
    ],
    "expectedResult": "The Agent uses the catalog to separate the creative keyframe decision, preparation, and image operation handoff, then returns a creator-facing submit-ready bound packet or the exact missing Tool binding without fabricating a provisional call packet or printing runtime invocation details.",
    "expectedFailure": "Stopping at concept analysis, requiring the user to name Skills, emitting a generic workflow, inventing Tool parameters, printing Tool schema or invocation JSON, returning a candidate call packet when blocked, or claiming generation success fails."
  },
  "fixtureRefs": ["creative-planning-workspace"],
  "runtimeProfileId": "markdown",
  "modelProfileIds": ["configured-default"],
  "steps": [
    {
      "id": "submit",
      "kind": "submit",
      "prompt": "读取 @screenplay.fountain。先把开场压缩成一个明确的关键帧决定，再准备成可交给当前 AI 图像能力的生产交接；不要执行生成，也不要让我点名能力。不要只写创意概述，只返回：镜头决定、来源绑定、生成交接、直接验收、下游用途。若能力或素材引用无法从当前 Tool schema 和真实来源绑定，写精确阻塞，不得编造；不要展示工具名、schema 字段、原始 locator、运行时 ID、参数表或调用 JSON。"
    },
    { "id": "idle", "kind": "wait-for-idle", "timeoutMs": 180000 }
