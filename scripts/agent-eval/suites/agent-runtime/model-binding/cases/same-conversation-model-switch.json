{
  "schema": "neko.agent-eval.scenario",
  "id": "same-conversation-model-switch",
  "suiteId": "agent-runtime.model-binding",
  "caseGroup": "workflow",
  "visibility": "public",
  "evidenceContract": {
    "userBehavior": "While a visible Turn is running, switch models through the enabled Composer control and send a follow-up that keeps its exact configuration binding.",
    "canonicalPath": [
      "same Desktop Conversation",
      "first immutable Turn configuration snapshot",
      "visible active-Turn model selection",
      "message-bound inbox configuration",
      "next immutable Turn configuration snapshot",
      "exact DSH Session model configuration"
    ],
    "observables": [
      {
        "ref": "model-sequence-facts",
        "kind": "runtime-fact",
        "description": "Per-turn requested/effective model facts with one stable Conversation/DSH Session binding and distinct numeric DSH turn identities.",
        "required": true
      }
    ],
    "expectedResult": "The active Turn remains on gpt-5.5, the queued follow-up uses gpt-5.6-luna, and both remain in the same Conversation without fallback.",
    "expectedFailure": "A disabled model control, mutation of the active request, processing-time configuration lookup, unavailable binding, implicit fallback, changed Conversation identity, or missing per-Turn facts fails."
  },
  "fixtureRefs": ["empty-workspace"],
  "runtimeProfileId": "canonical-default",
  "modelProfileIds": ["nekoapi-gpt-5.5", "nekoapi-gpt-5.6-luna"],
  "steps": [
    {
      "id": "first",
      "kind": "submit",
      "prompt": "Reply with one concise sentence identifying this as the first turn.",
      "modelProfileId": "nekoapi-gpt-5.5"
    },
    {
      "id": "first-idle",
      "kind": "wait-for-idle",
      "timeoutMs": 180000
    },
    {
      "id": "active-model-followup",
      "kind": "submit-with-followup",
      "prompt": "Give a careful multi-paragraph explanation of local-first state ownership, then end with ACTIVE_MODEL_FIRST_DONE.",
      "followupPrompt": "After the current response finishes, reply with exactly ACTIVE_MODEL_FOLLOWUP_DONE.",
      "followupModelProfileId": "nekoapi-gpt-5.6-luna",
      "delivery": "send-now",
      "activeTimeoutMs": 120000
    },
    { "id": "second-idle", "kind": "wait-for-idle", "timeoutMs": 180000 }
  ],
  "assertions": [
    { "id": "runtime", "kind": "runtime-errors-empty", "evidenceRef": "model-sequence-facts" },
    {
      "id": "active-update",
      "kind": "configuration-update",
      "stepId": "active-model-followup",
      "providerId": "nekoapi-chat",
      "modelId": "gpt-5.6-luna",
      "modelProfileId": "nekoapi-gpt-5.6-luna",
      "status": "applied",
      "turnState": "active",
      "turnCreated": false,
      "evidenceRef": "model-sequence-facts"
    },
    {
      "id": "sequence",
      "kind": "model-sequence",
      "turns": [
        { "idleStepId": "first-idle", "profileId": "nekoapi-gpt-5.5" },
        { "idleStepId": "second-idle", "profileId": "nekoapi-gpt-5.6-luna" }
      ],
      "evidenceRef": "model-sequence-facts"
    },
    {
      "id": "final-model",
      "kind": "model",
      "profileId": "nekoapi-gpt-5.6-luna",
      "evidenceRef": "model-sequence-facts"
    },
    {
      "id": "answer",
      "kind": "final-answer",
      "mode": "contains",
      "text": ["ACTIVE_MODEL_FOLLOWUP_DONE"],
      "evidenceRef": "model-sequence-facts"
    }
  ],
  "artifactChecks": [],
  "budget": { "timeoutMs": 360000, "repetitions": 1 },
  "execution": {
    "evidenceLevel": "visible-desktop",
    "resourceClass": "visible-ui",
    "protected": true,
    "startSurface": "workspace"
  }
}
