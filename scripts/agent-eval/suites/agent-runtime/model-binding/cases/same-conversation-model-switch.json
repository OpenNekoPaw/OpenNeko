{
  "schema": "neko.agent-eval.scenario",
  "id": "same-conversation-model-switch",
  "suiteId": "agent-runtime.model-binding",
  "caseGroup": "workflow",
  "visibility": "public",
  "evidenceContract": {
    "userBehavior": "Update the future-Turn model while the first Turn is running, preserve that Turn's immutable model snapshot, then run a second Turn with the updated model in the same Conversation.",
    "canonicalPath": [
      "same Desktop Conversation",
      "first immutable Turn configuration snapshot",
      "running-Turn future configuration update",
      "second immutable Turn configuration snapshot",
      "Pi provider/model registration"
    ],
    "observables": [
      {
        "ref": "model-sequence-facts",
        "kind": "runtime-fact",
        "description": "Per-Turn requested/effective model facts with stable Conversation and distinct Turn/run identities.",
        "required": true
      }
    ],
    "expectedResult": "The first Turn retains gpt-5.5, the second Turn uses gpt-5.6-luna, and both belong to the same Conversation without fallback.",
    "expectedFailure": "Mutable in-flight configuration, unavailable binding, implicit default fallback, changed Conversation identity, or missing per-Turn facts fails."
  },
  "fixtureRefs": ["empty-workspace"],
  "runtimeProfileId": "canonical-default",
  "modelProfileIds": ["nekoapi-gpt-5.5", "nekoapi-gpt-5.6-luna"],
  "steps": [
    {
      "id": "first",
      "kind": "submit",
      "prompt": "Reply with one concise sentence identifying this as the first turn.",
      "modelProfileId": "nekoapi-gpt-5.5"
    },
    {
      "id": "running-model-update",
      "kind": "update-configuration",
      "afterStepId": "first",
      "providerId": "nekoapi-chat",
      "modelId": "gpt-5.6-luna",
      "modelProfileId": "nekoapi-gpt-5.6-luna",
      "expectedStatus": "applied",
      "turnState": "running",
      "timeoutMs": 30000
    },
    { "id": "first-idle", "kind": "wait-for-idle", "timeoutMs": 180000 },
    {
      "id": "second",
      "kind": "submit",
      "prompt": "Reply with one concise sentence identifying this as the second turn in the same conversation.",
      "modelProfileId": "nekoapi-gpt-5.6-luna"
    },
    { "id": "second-idle", "kind": "wait-for-idle", "timeoutMs": 180000 }
  ],
  "assertions": [
    { "id": "runtime", "kind": "runtime-errors-empty", "evidenceRef": "model-sequence-facts" },
    {
      "id": "running-update",
      "kind": "configuration-update",
      "stepId": "running-model-update",
      "providerId": "nekoapi-chat",
      "modelId": "gpt-5.6-luna",
      "modelProfileId": "nekoapi-gpt-5.6-luna",
      "status": "applied",
      "turnState": "running",
      "turnCreated": false,
      "evidenceRef": "model-sequence-facts"
    },
    {
      "id": "sequence",
      "kind": "model-sequence",
      "turns": [
        { "idleStepId": "first-idle", "profileId": "nekoapi-gpt-5.5" },
        { "idleStepId": "second-idle", "profileId": "nekoapi-gpt-5.6-luna" }
      ],
      "evidenceRef": "model-sequence-facts"
    },
    {
      "id": "final-model",
      "kind": "model",
      "profileId": "nekoapi-gpt-5.6-luna",
      "evidenceRef": "model-sequence-facts"
    },
    {
      "id": "answer",
      "kind": "final-answer",
      "mode": "non-empty",
      "evidenceRef": "model-sequence-facts"
    }
  ],
  "artifactChecks": [],
  "budget": { "timeoutMs": 360000, "repetitions": 1 },
  "execution": {
    "evidenceLevel": "hidden-desktop",
    "resourceClass": "text",
    "protected": false,
    "startSurface": "workspace"
  }
}
