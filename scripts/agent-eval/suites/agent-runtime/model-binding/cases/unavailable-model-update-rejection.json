      {
        "ref": "unavailable-model-facts",
        "kind": "runtime-fact",
        "description": "Rejected requested model identity and diagnostic, unchanged submission count, stable Conversation, and per-Turn effective configuration facts.",
        "required": true
      }
    ],
    "expectedResult": "The unavailable model update is rejected with no Turn, and both real Turns keep the prior authorized model under one Conversation.",
    "expectedFailure": "Creating a Turn for the update, silently selecting another model/provider, mutating the prior configuration, or changing Conversation identity fails."
  },
