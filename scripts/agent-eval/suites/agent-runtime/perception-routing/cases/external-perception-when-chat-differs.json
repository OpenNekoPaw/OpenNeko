{
  "schema": "neko.agent-eval.scenario",
  "id": "external-perception-when-chat-differs",
  "suiteId": "agent-runtime.perception-routing",
  "caseGroup": "canonical",
  "visibility": "public",
  "evidenceContract": {
    "userBehavior": "Generate an image with a non-vision chat model and analyze the real result through the perception capability.",
    "canonicalPath": [
      "explicit non-vision chat model",
      "exact DSH Session turn snapshot",
      "terminal GenerateImage Tool result",
      "stable image_ref binding",
      "perception.image.understand",
      "image.understand purpose snapshot"
    ],
    "observables": [
      {
        "ref": "perception-facts",
        "kind": "runtime-fact",
        "description": "Exact main and image-understanding models, stable image resource, perception Tool call, structured evidence, usage, and final analysis facts.",
        "required": true
      }
    ],
    "expectedResult": "The non-vision main model routes the stable delivered image reference through perception.image.understand using the exact image.understand purpose snapshot before analysis.",
    "expectedFailure": "Model fallback, missing terminal GenerateImage Tool result, absent perception call, or guessed output fails."
  },
  "fixtureRefs": ["empty-workspace"],
  "runtimeProfileId": "canonical-default",
  "modelProfileIds": ["deepseek-no-native-vision"],
  "steps": [
    {
      "id": "submit",
      "kind": "submit",
      "prompt": "生成一张猫玩红球的图片。任务完成后取得 Tool 结果中的 image_ref，使用该短引用调用 perception.image.understand，再基于结构化感知结果说明画面、构图、光影和质量问题；不要构造 locator，不要传 provider/model/path，也不要根据提示词猜测。"
    },
    { "id": "idle", "kind": "wait-for-idle", "timeoutMs": 1200000 }
  ],
  "assertions": [
    {
      "id": "model",
      "kind": "model",
      "profileId": "deepseek-no-native-vision",
      "evidenceRef": "perception-facts"
    },
    {
      "id": "generate-image",
      "kind": "tool-call",
      "name": "GenerateImage",
      "status": "success",
      "evidenceRef": "perception-facts"
    },
    {
      "id": "perception",
      "kind": "tool-call",
      "name": "perception.image.understand",
      "status": "success",
      "resultIncludes": {
        "source": "tool",
        "toolName": "perception.image.understand",
        "modelContext": { "providerId": "nekoapi-chat", "modelId": "gpt-5.6-luna" },
        "data": { "kind": "perception.image.understand", "usage": {} }
      },
      "evidenceRef": "perception-facts"
    },
    {
      "id": "no-read-image",
      "kind": "tool-call",
      "name": "read_image",
      "status": "absent",
      "evidenceRef": "perception-facts"
    },
    {
      "id": "answer",
      "kind": "final-answer",
      "mode": "contains",
      "text": ["猫", "画面"],
      "evidenceRef": "perception-facts"
    },
    {
      "id": "terminal",
      "kind": "terminal-idle",
      "concerns": ["turnIdle", "continuationQueueIdle"],
      "evidenceRef": "perception-facts"
    }
  ],
  "artifactChecks": [],
  "budget": { "timeoutMs": 1200000, "repetitions": 1 }
}
