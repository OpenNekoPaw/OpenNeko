{
  "schema": "neko.agent-eval.scenario",
  "id": "linked-media-search-read",
  "suiteId": "agent-runtime.media-library-content",
  "caseGroup": "canonical",
  "visibility": "public",
  "evidenceContract": {
    "userBehavior": "Attach a confirmed linked Media Library image by its portable locator and read the same short reference through the normal content capability.",
    "canonicalPath": [
      "Desktop Media Library registration controls",
      "Project explicit Media Library recovery controls",
      "media-library locator context binding",
      "ReadImage image_ref resolution",
      "Project ContentReadService"
    ],
    "observables": [
      {
        "ref": "media-library-facts",
        "kind": "runtime-fact",
        "description": "Successful content-read Tool facts preserve the portable Media Library locator and marker text without Host binding details.",
        "required": true
      }
    ],
    "expectedResult": "The linked image context exposes one short image_ref and ReadImage resolves it to the exact media-library locator before the final marker.",
    "expectedFailure": "Missing explicit binding, workspace-file substitution, absolute path disclosure, failed image read, runtime diagnostics, or missing marker fails visibly."
  },
  "fixtureRefs": [
    "media-library-workspace"
  ],
  "runtimeProfileId": "canonical-default",
  "modelProfileIds": [
    "configured-default"
  ],
  "steps": [
    {
      "id": "submit",
      "kind": "submit",
      "prompt": "使用附件中显示的 image_ref 调用 ReadImage 一次，image_refs 只包含这一个短引用，analysis=describe。不要调用搜索、Asset、Read 或 shell 工具，不要构造 locator、绝对路径、链接目标、缓存路径或 project://assets。读取成功后输出 MEDIA_LIBRARY_CANONICAL_7X9，并单独输出 MEDIA_LIBRARY_READ_OK。",
      "contextPayloads": [
        {
          "type": "image",
          "id": "media-library:workspace/library-image.svg",
          "label": "library-image.svg",
          "summary": "Confirmed linked Media Library image",
          "data": {
            "kind": "authorized-content-reference",
            "locator": {
              "kind": "media-library",
              "libraryName": "workspace",
              "relativePath": "library-image.svg"
            },
            "mediaType": "image",
            "source": "media-library"
          }
        }
      ]
    },
    {
      "id": "idle",
      "kind": "wait-for-idle",
      "timeoutMs": 180000
    }
  ],
  "assertions": [
    {
      "id": "runtime",
      "kind": "runtime-errors-empty",
      "evidenceRef": "media-library-facts"
    },
    {
      "id": "idle",
      "kind": "fully-idle",
      "evidenceRef": "media-library-facts"
    },
    {
      "id": "read",
      "kind": "tool-call",
      "name": "ReadImage",
      "status": "success",
      "expectedArguments": {
        "images": [
          {
            "contentLocator": {
              "kind": "media-library",
              "libraryName": "workspace",
              "relativePath": "library-image.svg"
            }
          }
        ],
        "mode": "metadata",
        "max_images": 1
      },
      "resultIncludes": {
        "mode": "metadata",
        "imageCount": 1,
        "images": [
          {
            "contentLocator": {
              "kind": "media-library",
              "libraryName": "workspace",
              "relativePath": "library-image.svg"
            }
          }
        ]
      },
      "evidenceRef": "media-library-facts"
    },
    {
      "id": "no-project-search",
      "kind": "tool-call",
      "name": "QueryProjectSearch",
      "status": "absent",
      "evidenceRef": "media-library-facts"
    },
    {
      "id": "answer",
      "kind": "final-answer",
      "mode": "contains",
      "text": [
        "MEDIA_LIBRARY_CANONICAL_7X9",
        "MEDIA_LIBRARY_READ_OK"
      ],
      "evidenceRef": "media-library-facts"
    }
  ],
  "artifactChecks": [],
  "budget": {
    "timeoutMs": 180000,
    "repetitions": 1
  }
}
