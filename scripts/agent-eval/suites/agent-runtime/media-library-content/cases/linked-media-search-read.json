{
  "schema": "neko.agent-eval.scenario",
  "id": "linked-media-search-read",
  "suiteId": "agent-runtime.media-library-content",
  "caseGroup": "canonical",
  "visibility": "public",
  "evidenceContract": {
    "userBehavior": "Attach one document and one image through a managed Workspace Media Library link and read both through their Workspace references.",
    "canonicalPath": [
      "managed neko/assets Workspace link",
      "workspace-file context binding",
      "ReadDocument input_ref resolution",
      "ReadImage image_ref resolution",
      "Workspace ContentReadService managed-link authorization"
    ],
    "observables": [
      {
        "ref": "media-library-facts",
        "kind": "runtime-fact",
        "description": "Successful document and image Tool facts preserve Workspace locators and marker text without Host link targets.",
        "required": true
      }
    ],
    "expectedResult": "ReadDocument and ReadImage resolve their short references to exact workspace-file locators below the managed link before the final marker.",
    "expectedFailure": "A media-library locator, absolute target, .neko binding, failed linked read, runtime diagnostic, or missing marker fails visibly."
  },
  "fixtureRefs": ["media-library-workspace"],
  "runtimeProfileId": "canonical-default",
  "modelProfileIds": ["configured-default"],
  "steps": [
    {
      "id": "submit",
      "kind": "submit",
      "prompt": "先使用附件中 linked-story.md 的 input_ref 调用 ReadDocument 一次，mode=content、include_images=false、max_chars=1000；再使用 library-image.svg 的 image_ref 调用 ReadImage 一次，image_refs 只包含这一个短引用，analysis=describe。不要调用搜索、Asset、Read 或 shell 工具，不要构造 locator、绝对路径、链接目标、缓存路径或 media-library。两次读取成功后输出 MEDIA_LIBRARY_DOCUMENT_7X9，并单独输出 WORKSPACE_LINKED_MEDIA_READ_OK。",
      "contextPayloads": [
        {
          "type": "file",
          "id": "workspace-file:neko/assets/workspace/linked-story.md",
          "label": "linked-story.md",
          "summary": "Workspace-linked document",
          "data": {
            "kind": "authorized-content-reference",
            "locator": {
              "kind": "workspace-file",
              "path": "neko/assets/workspace/linked-story.md"
            },
            "mediaType": "document",
            "source": "workspace"
          }
        },
        {
          "type": "image",
          "id": "workspace-file:neko/assets/workspace/library-image.svg",
          "label": "library-image.svg",
          "summary": "Confirmed linked Media Library image",
          "data": {
            "kind": "authorized-content-reference",
            "locator": {
              "kind": "workspace-file",
              "path": "neko/assets/workspace/library-image.svg"
            },
            "mediaType": "image",
            "source": "workspace"
          }
        }
      ]
    },
    {
      "id": "idle",
      "kind": "wait-for-idle",
      "timeoutMs": 180000
    }
  ],
  "assertions": [
    {
      "id": "runtime",
      "kind": "runtime-errors-empty",
      "evidenceRef": "media-library-facts"
    },
    {
      "id": "idle",
      "kind": "fully-idle",
      "evidenceRef": "media-library-facts"
    },
    {
      "id": "read-document",
      "kind": "tool-call",
      "name": "ReadDocument",
      "status": "success",
      "expectedArguments": {
        "source": {
          "kind": "workspace-file",
          "path": "neko/assets/workspace/linked-story.md"
        },
        "mode": "content",
        "start_batch": false,
        "include_manifest": false,
        "include_images": false,
        "max_chars": 1000,
        "max_images": 5
      },
      "resultIncludes": {
        "source": {
          "kind": "workspace-file",
          "path": "neko/assets/workspace/linked-story.md"
        },
        "text": "MEDIA_LIBRARY_DOCUMENT_7X9"
      },
      "evidenceRef": "media-library-facts"
    },
    {
      "id": "read-image",
      "kind": "tool-call",
      "name": "ReadImage",
      "status": "success",
      "expectedArguments": {
        "images": [
          {
            "contentLocator": {
              "kind": "workspace-file",
              "path": "neko/assets/workspace/library-image.svg"
            }
          }
        ],
        "mode": "metadata",
        "max_images": 1
      },
      "resultIncludes": {
        "mode": "metadata",
        "imageCount": 1,
        "images": [
          {
            "contentLocator": {
              "kind": "workspace-file",
              "path": "neko/assets/workspace/library-image.svg"
            }
          }
        ]
      },
      "evidenceRef": "media-library-facts"
    },
    {
      "id": "no-project-search",
      "kind": "tool-call",
      "name": "QueryProjectSearch",
      "status": "absent",
      "evidenceRef": "media-library-facts"
    },
    {
      "id": "answer",
      "kind": "final-answer",
      "mode": "contains",
      "text": ["MEDIA_LIBRARY_DOCUMENT_7X9", "WORKSPACE_LINKED_MEDIA_READ_OK"],
      "evidenceRef": "media-library-facts"
    }
  ],
  "artifactChecks": [],
  "budget": {
    "timeoutMs": 180000,
    "repetitions": 1
  }
}
