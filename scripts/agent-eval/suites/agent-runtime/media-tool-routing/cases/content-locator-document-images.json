{
  "schema": "neko.agent-eval.scenario",
  "id": "content-locator-document-images",
  "suiteId": "agent-runtime.media-tool-routing",
  "caseGroup": "canonical",
  "visibility": "public",
  "evidenceContract": {
    "userBehavior": "An image-capable Agent screens a bounded EPUB image batch at overview detail, forms a selection, and rereads only the selected page at original detail.",
    "canonicalPath": [
      "visible Desktop submit",
      "openneko_document read-images",
      "document-entry ContentLocator",
      "openneko_read_images contact-sheet overview",
      "selected original-detail confirmation",
      "Host-authorized Content bytes",
      "DSH durable attachment",
      "native multimodal continuation"
    ],
    "observables": [
      {
        "ref": "document-image-facts",
        "kind": "runtime-fact",
        "description": "Exact model, successful overview and selected-original Content image calls, pixel-only codes, terminal idle state, and absence of runtime errors.",
        "required": true
      }
    ],
    "expectedResult": "The Agent screens both fixture pages with overview detail, confirms only the N7Q4 page with original detail, and reports both synthetic pixel codes.",
    "expectedFailure": "Missing overview or original-detail evidence, original-detail reads before selection, failed entry authorization, raw extraction paths, guessed codes, runtime errors, or non-idle completion fails visibly."
  },
  "fixtureRefs": ["document-image-workspace"],
  "runtimeProfileId": "canonical-default",
  "modelProfileIds": ["native-vision"],
  "steps": [
    {
      "id": "submit",
      "kind": "submit",
      "prompt": "读取工作区 synthetic-document.epub 中的两张内嵌图片并报告每张图黑色区域里的四位字符。必须先调用 openneko_document 的 read-images 获得原样 ContentLocator；第一批必须只调用一次 openneko_read_images，把两张图作为一张低清联系表总览并先形成筛选结论；然后只对包含 N7Q4 的入选页面调用一次 openneko_read_image detail=original 复核。不得对任何页面调用 openneko_read_image overview，不得以 original 读取另一张图，不要使用原始解压路径、不要猜测。最终列出两组字符并回复 OVERVIEW_THEN_ORIGINAL_OK。"
    },
    { "id": "idle", "kind": "wait-for-idle", "timeoutMs": 1200000 }
  ],
  "assertions": [
    {
      "id": "model",
      "kind": "model",
      "profileId": "native-vision",
      "evidenceRef": "document-image-facts"
    },
    {
      "id": "runtime",
      "kind": "runtime-errors-empty",
      "evidenceRef": "document-image-facts"
    },
    {
      "id": "document-tool",
      "kind": "tool-call",
      "name": "openneko_document",
      "status": "success",
      "evidenceRef": "document-image-facts"
    },
    {
      "id": "content-image-overview",
      "kind": "tool-call",
      "name": "openneko_read_images",
      "status": "success",
      "expectedArguments": {
        "sources": [
          {
            "file": { "authority": "workspace", "path": "synthetic-document.epub" },
            "selector": { "kind": "entry", "path": "OEBPS/images/page-1.png" }
          },
          {
            "file": { "authority": "workspace", "path": "synthetic-document.epub" },
            "selector": { "kind": "entry", "path": "OEBPS/images/page-2.png" }
          }
        ]
      },
      "evidenceRef": "document-image-facts"
    },
    {
      "id": "content-image-original",
      "kind": "tool-call",
      "name": "openneko_read_image",
      "status": "success",
      "expectedArguments": {
        "source": {
          "file": { "authority": "workspace", "path": "synthetic-document.epub" },
          "selector": { "kind": "entry", "path": "OEBPS/images/page-1.png" }
        },
        "detail": "original"
      },
      "resultIncludes": { "detail": "original" },
      "evidenceRef": "document-image-facts"
    },
    {
      "id": "pixel-codes",
      "kind": "final-answer",
      "mode": "contains",
      "text": ["N7Q4", "Q47N", "OVERVIEW_THEN_ORIGINAL_OK"],
      "evidenceRef": "document-image-facts"
    },
    {
      "id": "terminal",
      "kind": "terminal-idle",
      "concerns": ["turnIdle", "continuationQueueIdle"],
      "evidenceRef": "document-image-facts"
    }
  ],
  "artifactChecks": [],
  "budget": { "timeoutMs": 1200000, "repetitions": 1 }
}
