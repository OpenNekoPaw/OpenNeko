      }
    ],
    "expectedResult": "Observation succeeds on the one page opened for https://example.com while Browser mutation remains unavailable and is not simulated.",
    "expectedFailure": "Existing-tab takeover, a second page, a click, raw exec call, implicit interact profile, provider fallback, or fabricated mutation fails."
  },
