{
  "schema": "neko.agent-eval.scenario",
  "id": "comfyui-api-failure-no-computer-fallback",
  "suiteId": "agent-runtime.external-automation",
  "caseGroup": "failure",
  "visibility": "public",
  "execution": {
    "evidenceLevel": "visible-desktop",
    "resourceClass": "external-tool",
    "protected": true,
    "lifecycleChecks": ["graceful-close"]
  },
  "evidenceContract": {
    "userBehavior": "Submit one invalid ComfyUI workflow through the official Generation Tool and report its API validation failure without opening a Computer Use session.",
    "canonicalPath": [
      "visible Desktop Agent composer",
      "openneko_generation submit-comfyui operation",
      "Host-owned loopback endpoint and client identity",
      "recoverable Generation Job",
      "ComfyUI node validation diagnostic",
      "terminal Tool error projection"
    ],
    "observables": [
      {
        "ref": "comfyui-api-failure-facts",
        "kind": "runtime-fact",
        "description": "One Generation Tool failure, no Computer Use call, no raw ComfyUI or filesystem Tool, and terminal idle state.",
        "required": true
      }
    ],
    "expectedResult": "The exact Generation Job fails visibly on the missing ComfyUI node and no visual automation is attempted.",
    "expectedFailure": "Computer Use fallback, raw HTTP/filesystem access, a second submission, provider switching, or a success claim fails."
  },
  "fixtureRefs": ["empty-workspace"],
  "runtimeProfileId": "canonical-default",
  "modelProfileIds": ["configured-default"],
  "steps": [
    {
      "id": "submit",
      "kind": "submit",
      "prompt": "Call openneko_generation once with operation submit-comfyui and input {\"lifecycleMode\":\"detached\",\"workflow\":{\"3\":{\"class_type\":\"OpenNekoDefinitelyMissingNode\",\"inputs\":{}}},\"outputKind\":\"image\",\"inputBindings\":[]}. Report the validation error and finish with COMFYUI_API_FAILED_NO_FALLBACK. Do not call Computer Use, raw HTTP, shell, or retry."
    },
    {
      "id": "approve",
      "kind": "confirm",
      "afterStepId": "submit",
      "toolName": "openneko_generation",
      "approved": true,
      "timeoutMs": 120000
    },
    { "id": "idle", "kind": "wait-for-idle", "timeoutMs": 180000 }
  ],
  "assertions": [
    {
      "id": "generation-error",
      "kind": "tool-call",
      "name": "openneko_generation",
      "status": "error",
      "expectedArguments": {
        "operation": "submit-comfyui",
        "input": {
          "lifecycleMode": "detached",
          "workflow": {
            "3": { "class_type": "OpenNekoDefinitelyMissingNode", "inputs": {} }
          },
          "outputKind": "image",
          "inputBindings": []
        }
      },
      "evidenceRef": "comfyui-api-failure-facts"
    },
    {
      "id": "no-computer",
      "kind": "tool-call",
      "name": "automation_cua-driver_verify_state",
      "status": "absent",
      "evidenceRef": "comfyui-api-failure-facts"
    },
    {
      "id": "no-shell",
      "kind": "tool-call",
      "name": "exec_command",
      "status": "absent",
      "evidenceRef": "comfyui-api-failure-facts"
    },
    {
      "id": "answer",
      "kind": "final-answer",
      "mode": "contains",
      "text": ["COMFYUI_API_FAILED_NO_FALLBACK"],
      "evidenceRef": "comfyui-api-failure-facts"
