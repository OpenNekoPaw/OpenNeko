    "menus": {
      "explorer/context": [
        {
          "command": "neko.tools.compareFiles",
          "group": "3_compare@1",
          "when": "listMultiSelection && resourceExtname =~ /\\.(png|jpg|jpeg|gif|webp|bmp|svg|mp4|mov|avi|mkv|webm|m4v|mp3|wav|ogg|flac|aac|m4a)$/i"
        },
        {
          "command": "neko.tools.showMediaInfo",
          "group": "neko@1",
          "when": "resourceExtname =~ /\\.(png|jpg|jpeg|gif|webp|bmp|svg|mp4|mov|avi|mkv|webm|m4v|mp3|wav|ogg|flac|aac|m4a)$/i"
        },
        {
          "command": "neko.assets.previewMedia",
          "when": "resourceExtname =~ /\\.(mp4|mov|avi|mkv|webm|m4v|ts|flv|wmv|mp3|wav|ogg|flac|aac|m4a|wma|opus)$/i",
          "group": "3_nekoOps@1"
        },
        {
          "command": "neko.assets.addToTimeline",
          "when": "resourceExtname =~ /\\.(mp4|mov|avi|mkv|webm|m4v|mp3|wav|ogg|flac|aac|m4a|png|jpg|jpeg|gif|webp)$/i",
          "group": "3_nekoOps@2"
        },
        {
          "command": "neko.assets.addToCanvas",
          "when": "resourceExtname =~ /\\.(png|jpg|jpeg|gif|webp|svg|bmp|mp4|mov|webm)$/i",
          "group": "3_nekoOps@3"
        },
        {
          "command": "neko.agent.addToContext",
          "group": "9_nekoai@0",
          "when": "!explorerResourceIsFolder"
        },
        {
          "command": "neko.ai.summarizeDocument",
          "group": "9_nekoai@1",
          "when": "resourceExtname =~ /\\.pdf|\\.docx|\\.doc|\\.epub|\\.pptx|\\.ppt|\\.xlsx|\\.xls|\\.fdx|\\.txt|\\.md|\\.fountain/"
        },
        {
          "command": "neko.ai.chatWithDocument",
          "group": "9_nekoai@2",
          "when": "resourceExtname =~ /\\.pdf|\\.docx|\\.doc|\\.epub|\\.pptx|\\.ppt|\\.xlsx|\\.xls|\\.fdx|\\.txt|\\.md|\\.fountain/"
        },
        {
          "command": "neko.agent.createFromFile",
          "group": "9_nekoai@3",
          "when": "resourceExtname =~ /\\.fountain|\\.md|\\.txt|\\.pdf|\\.docx/"
        },
        {
          "command": "neko.ai.analyzeImage",
          "group": "9_nekoai@4",
          "when": "resourceExtname =~ /\\.png|\\.jpg|\\.jpeg|\\.gif|\\.webp|\\.bmp/"
        },
        {
          "command": "neko.ai.extractImageText",
          "group": "9_nekoai@5",
          "when": "resourceExtname =~ /\\.png|\\.jpg|\\.jpeg|\\.gif|\\.webp|\\.bmp/"
        },
        {
          "command": "neko.ai.analyzeVideo",
          "group": "9_nekoai@6",
          "when": "resourceExtname =~ /\\.mp4|\\.mov|\\.mkv|\\.avi|\\.webm|\\.m4v/"
        },
        {
          "command": "neko.ai.generateSubtitles",
          "group": "9_nekoai@7",
          "when": "resourceExtname =~ /\\.mp4|\\.mov|\\.mkv|\\.avi|\\.webm|\\.m4v/"
        }
      ],
      "view/title": [
        {
          "command": "neko.assets.addMediaLibrary",
          "when": "view == neko.mediaLibraries",
          "group": "navigation"
        },
        {
          "command": "neko.assets.refreshMediaLibraries",
          "when": "view == neko.mediaLibraries",
          "group": "overflow"
        },
        {
          "command": "neko.assets.searchMediaLibrary",
          "when": "view == neko.mediaLibraries",
          "group": "overflow"
        },
        {
          "command": "neko.entityBrowser.refresh",
          "when": "view == neko.entityBrowser",
          "group": "navigation"
        },
        {
          "command": "neko.entityBrowser.createCandidate",
          "when": "view == neko.entityBrowser",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "neko.assets.removeMediaLibrary",
          "when": "viewItem == mediaLibrary || viewItem == mediaLibrary:offline",
          "group": "inline"
        },
        {
          "command": "neko.assets.relinkMediaLibrary",
          "when": "viewItem == mediaLibrary || viewItem == mediaLibrary:offline",
          "group": "1_modify"
        },
        {
          "command": "neko.assets.previewMediaLibraryFile",
          "when": "viewItem =~ /^mediaLibrary:file:/",
          "group": "2_preview"
        },
        {
          "command": "neko.assets.deleteMediaLibraryFile",
          "when": "viewItem =~ /^mediaLibrary:file:/",
          "group": "9_delete"
        },
        {
          "command": "neko.assets.copyToMediaLibrary",
          "when": "viewItem =~ /^mediaLibrary:file:/",
          "group": "3_actions@3"
        },
        {
          "command": "neko.assets.addToTimelineFromLibrary",
          "when": "viewItem =~ /^mediaLibrary:file:(video|audio|image|sequence)$/",
          "group": "3_actions"
        },
        {
          "command": "neko.assets.addToCanvasFromLibrary",
          "when": "viewItem =~ /^mediaLibrary:file:(video|image|sequence)$/",
          "group": "3_actions"
        },
        {
          "command": "neko.assets.revealFileInOS",
          "when": "viewItem =~ /^mediaLibrary:file:/",
          "group": "4_utils"
        },
        {
          "command": "neko.assets.copyFilePath",
          "when": "viewItem =~ /^mediaLibrary:file:/",
          "group": "4_utils"
        },
        {
          "command": "neko.assets.copyFileReference",
          "when": "viewItem =~ /^mediaLibrary:file:/",
          "group": "4_utils@2"
        },
        {
          "command": "neko.assets.directory.reveal",
          "when": "viewItem == mediaLibrary:directory",
          "group": "4_utils@1"
        },
        {
          "command": "neko.assets.addToAgent",
          "when": "viewItem =~ /^mediaLibrary:file:/",
          "group": "5_agent@1"
        },
        {
          "command": "neko.entityBrowser.inspect",
          "when": "viewItem == entityBrowser:entity || viewItem == entityBrowser:candidate",
          "group": "inline"
        },
        {
          "command": "neko.entityBrowser.rename",
          "when": "viewItem == entityBrowser:entity",
          "group": "2_modify@1"
        },
        {
          "command": "neko.entityBrowser.editAppearance",
          "when": "viewItem == entityBrowser:entity",
          "group": "2_modify@2"
        },
        {
          "command": "neko.canvas.deleteNodeFromOutline",
          "when": "view == neko.canvasOutline && viewItem == canvasNode",
          "group": "2_manage@1"
        }
      ],
      "neko.explorer.newProject": [
        {
          "command": "neko.canvas.new",
          "group": "1@3"
        }
      ],
      "editor/title": [
        {
          "command": "neko.ai.chat",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "neko.script.generate",
          "group": "neko@1",
          "when": "editorLangId =~ /markdown|plaintext|txt/"
        },
        {
          "command": "neko.script.optimize",
          "group": "neko@2",
          "when": "editorLangId =~ /markdown|plaintext|txt/"
        },
        {
          "command": "neko.script.generateImage",
          "group": "neko@3",
          "when": "editorLangId =~ /markdown|plaintext|txt/"
        },
        {
          "command": "neko.script.generateVideo",
          "group": "neko@4",
          "when": "editorLangId =~ /markdown|plaintext|txt/"
        },
        {
          "command": "neko.agent.createFromFile",
          "group": "neko@5",
          "when": "editorLangId =~ /markdown|plaintext|txt|nekostory/"
        },
        {
          "command": "neko.ai.summarizeDocument",
          "group": "neko@6",
          "when": "editorLangId == nekostory"
        },
        {
          "command": "neko.ai.chatWithDocument",
          "group": "neko@7",
          "when": "editorLangId == nekostory"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "neko.epubOutline",
          "name": "%neko.preview.epubOutline.name%",
          "when": "neko.epubEditorActive"
        },
        {
          "id": "neko.canvasOutline",
          "name": "%neko.canvas.outline.title%",
          "when": "activeCustomEditorId == 'neko.canvasEditor'",
          "icon": "$(list-tree)"
        }
      ],
      "neko-asset-manager": [
        {
          "id": "neko.mediaLibraries",
          "name": "%neko.views.mediaLibraries.name%",
          "contextualTitle": "%neko.views.mediaLibraries.contextualTitle%"
        },
        {
          "id": "neko.entityBrowser",
          "name": "%neko.entityBrowser.name%",
          "contextualTitle": "%neko.entityBrowser.contextualTitle%"
        },
        {
          "id": "neko.entityInspector",
          "name": "%neko.entityInspector.name%",
          "contextualTitle": "%neko.entityInspector.name%",
          "type": "webview"
        }
      ],
      "neko-assistant": [
        {
          "type": "webview",
          "id": "neko.aiAssistant",
          "name": "%neko.aiAssistant.name%",
          "contextualTitle": "%neko.aiAssistant.contextualTitle%"
        }
      ]
    },
    "neko.installTargets": [
      {
        "type": "media",
        "kind": "voice-pack",
        "activationEvent": "onInstallKind:media.voice-pack"
      },
      {
        "type": "shader",
        "activationEvent": "onInstallType:shader"
      },
      {
        "type": "skill",
        "activationEvent": "onInstallType:skill"
      },
      {
        "type": "endpoint",
        "activationEvent": "onInstallType:endpoint"
      },
      {
        "type": "provider",
        "activationEvent": "onInstallType:provider"
      },
      {
        "type": "model",
        "activationEvent": "onInstallType:model"
      },
      {
        "type": "processor",
        "activationEvent": "onInstallType:processor"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "neko-asset-manager",
          "title": "%neko.resources.title%",
          "icon": "$(file-media)"
        }
      ],
      "panel": [
        {
          "id": "neko-assistant",
          "title": "OpenNeko AI",
          "icon": "$(hubot)"
        }
      ]
    },
    "configuration": [
      {
        "title": "Neko Media Library",
        "properties": {
          "neko.entityInspector.autoFollow": {
            "type": "boolean",
            "default": false,
            "description": "%neko.entityInspector.autoFollow.description%"
          }
        }
      },
      {
        "title": "NekoCut",
        "properties": {
          "neko.cut.defaultProjectRoot": {
            "type": "string",
            "default": "projects/cut",
            "description": "Workspace-relative directory used only for new .otio documents."
          }
        }
      },
      {
        "title": "NekoAgent",
        "properties": {
          "neko.agent.provider": {
            "type": "string",
            "enum": [
              "anthropic",
              "openai",
              "google",
              "azure",
              "ollama",
              "neko-gateway",
              "custom-newapi",
              "ollama-local"
            ],
            "default": "ollama-local",
            "description": "Default AI provider"
          },
          "neko.agent.model": {
            "type": "string",
            "default": "ollama-local-default-chat",
            "description": "Default model to use"
          },
          "neko.agent.apiKey.anthropic": {
            "type": "string",
            "default": "",
            "description": "Anthropic API key"
          },
          "neko.agent.apiKey.openai": {
            "type": "string",
            "default": "",
            "description": "OpenAI API key"
          },
          "neko.agent.media.outputDir": {
            "type": "string",
            "default": "",
            "description": "Directory to save generated media. Defaults to <workspace>/neko/generated/file"
          },
          "neko.agent.media.showSaveNotification": {
            "type": "boolean",
            "default": true,
            "description": "Show a notification when generated media is saved to disk"
          },
          "neko.agent.mcp.servers": {
            "type": "array",
            "default": [],
            "description": "MCP server configurations",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Server name"
                },
                "transport": {
                  "type": "string",
                  "enum": [
                    "stdio",
                    "http"
                  ],
                  "description": "Transport type"
                },
                "command": {
                  "type": "string",
                  "description": "Command to run (for stdio)"
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Command arguments"
                },
                "url": {
                  "type": "string",
                  "description": "Server URL (for http)"
                },
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "Whether the server is enabled"
                }
              }
            }
          }
        }
      }
    ]
  }
}
