{
  "name": "neko-suite",
  "displayName": "OpenNeko",
  "description": "Local creative suite for media editing, previews, assets, canvas workflows, and AI assistance",
  "version": "0.0.1",
  "publisher": "neko",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/neko/creative-suite"
  },
  "engines": {
    "vscode": "^1.128.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:neko.agent.characterDialogue",
    "onCommand:neko.agent.clearDndPayload",
    "onCommand:neko.agent.embodyCharacter",
    "onCommand:neko.agent.refreshModels",
    "onCommand:neko.agent.registerCapabilities",
    "onCommand:neko.agent.registerSlashCommands",
    "onCommand:neko.agent.sendContext",
    "onCommand:neko.assets.queryMediaLibrary",
    "onCommand:neko.entity.addAlias",
    "onCommand:neko.entity.bindAsset",
    "onCommand:neko.entity.confirmCandidate",
    "onCommand:neko.entity.dismissCandidate",
    "onCommand:neko.entity.getEntity",
    "onCommand:neko.entity.getEntityDetail",
    "onCommand:neko.entity.inspectEntity",
    "onCommand:neko.entity.listCandidates",
    "onCommand:neko.entity.listEntities",
    "onCommand:neko.entity.mergeCandidate",
    "onCommand:neko.entity.proposeCandidate",
    "onCommand:neko.entity.rejectCandidate",
    "onCommand:neko.entity.removeAlias",
    "onCommand:neko.entity.renameEntity",
    "onCommand:neko.entity.resolveByName",
    "onCommand:neko.entity.setDefaultBinding",
    "onCommand:neko.entity.triggerBindingWidgetAction",
    "onCommand:neko.entity.updateMetadata",
    "onCommand:neko.entity.upsertVisualDraft",
    "onCommand:neko.entityInspector.follow",
    "onCommand:neko.preview.revealDocumentLocator",
    "onInstallKind:media.voice-pack",
    "onInstallType:endpoint",
    "onInstallType:model",
    "onInstallType:processor",
    "onInstallType:provider",
    "onInstallType:shader",
    "onInstallType:skill"
  ],
  "categories": [
    "Machine Learning",
    "Other",
    "Visualization"
  ],
  "keywords": [
    "3d",
    "agent",
    "ai",
    "asset",
    "assets",
    "assistant",
    "audio",
    "canvas",
    "cbz",
    "compare",
    "creative",
    "creative-entity",
    "design",
    "diff",
    "document",
    "docx",
    "editing",
    "editor",
    "epub",
    "filmmaking",
    "gltf",
    "image",
    "library",
    "llm",
    "local-first",
    "mcp",
    "media",
    "model",
    "pdf",
    "player",
    "preview",
    "timeline",
    "video"
  ],
  "scripts": {
    "vscode:prepublish": "pnpm run compile && node scripts/validate-manifest.mjs",
    "compile": "node scripts/stage-feature-resources.mjs --build && esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:sharp --format=cjs --platform=node && node ../../scripts/stage-sharp-runtime.mjs --output-root dist",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs && vitest run",
    "package": "node ../../scripts/package-openneko-platform.mjs"
  },
  "dependencies": {
    "@neko-agent/types": "workspace:*",
    "@neko-canvas/domain": "workspace:*",
    "@neko-cut/domain": "workspace:*",
    "@neko-tools/contracts": "workspace:*",
    "@neko/agent": "workspace:*",
    "@neko/ai-sdk": "workspace:*",
    "@neko/chara": "workspace:*",
    "@neko/content": "workspace:*",
    "@neko/entity": "workspace:*",
    "@neko/generation": "workspace:*",
    "@neko/media": "workspace:*",
    "@neko/platform": "workspace:*",
    "@neko/quality": "workspace:*",
    "@neko/search": "workspace:*",
    "@neko/shared": "workspace:*",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "adm-zip": "^0.6.0",
    "esbuild": "^0.19.8"
  },
  "files": [
    "dist/**",
    "package.nls.json",
    "package.nls.zh-cn.json",
    "l10n/**",
    "README.md",
    "LICENSE"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Neko macOS Dark",
        "uiTheme": "vs-dark",
        "path": "./dist/features/neko-tools/themes/neko-macos-dark-color-theme.json"
      },
      {
        "label": "Neko macOS Light",
        "uiTheme": "vs",
        "path": "./dist/features/neko-tools/themes/neko-macos-light-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "neko-file-icons",
        "label": "Neko File Icons",
        "path": "./dist/features/neko-tools/themes/neko-file-icon-theme.json"
      }
    ],
    "languages": [
      {
        "id": "neko-canvas-file",
        "aliases": [
          "Neko Canvas"
        ],
        "extensions": [
          ".nkc"
        ],
        "icon": {
          "light": "./dist/features/neko-tools/themes/icons/file-canvas.svg",
          "dark": "./dist/features/neko-tools/themes/icons/file-canvas.svg"
        }
      },
      {
        "id": "epub",
        "extensions": [
          ".epub"
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "neko.mediaDiff",
        "displayName": "Media Diff",
        "selector": [
          {
            "filenamePattern": "*.{png,jpg,jpeg,gif,webp,bmp,svg,mp4,mov,avi,mkv,webm,m4v,mp3,wav,ogg,flac,aac,m4a}"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "neko.modelPreview",
        "displayName": "%neko.preview.modelPreview.displayName%",
        "selector": [
          {
            "filenamePattern": "*.{glb,gltf,obj,stl,ply}"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "neko.videoPreview",
        "displayName": "%neko.preview.videoPreview.displayName%",
        "selector": [
          {
            "filenamePattern": "*.{mp4,mov,avi,mkv,webm,m4v,ts,flv,wmv}"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "neko.audioPreview",
        "displayName": "%neko.preview.audioPreview.displayName%",
        "selector": [
          {
            "filenamePattern": "*.{mp3,wav,ogg,flac,aac,m4a,wma,opus}"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "neko.pdfPreview",
        "displayName": "%neko.preview.pdfPreview.displayName%",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "neko.cbzPreview",
        "displayName": "%neko.preview.cbzPreview.displayName%",
        "selector": [
          {
            "filenamePattern": "*.cbz"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "neko.epubPreview",
        "displayName": "%neko.preview.epubPreview.displayName%",
        "selector": [
          {
            "filenamePattern": "*.epub"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "neko.docxPreview",
        "displayName": "%neko.preview.docxPreview.displayName%",
        "selector": [
          {
            "filenamePattern": "*.docx"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "neko.cut.otioEditor",
        "displayName": "Neko Cut",
        "selector": [
          {
            "filenamePattern": "*.otio"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "neko.canvasEditor",
        "displayName": "Canvas Editor",
        "selector": [
          {
            "filenamePattern": "*.nkc"
          }
        ],
        "priority": "default"
      }
    ],
