{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["../../packages/neko-agent/packages/webview/src/*"],
      "@neko-agent/types": ["../../packages/neko-agent/packages/agent-types/src/index.ts"],
      "@neko-agent/types/*": ["../../packages/neko-agent/packages/agent-types/src/*"],
      "@neko/shared": ["../../packages/neko-types/src/index.ts"],
      "@neko/shared/*": ["../../packages/neko-types/src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/**/*",
    "forge.config.ts",
    "vite.main.config.ts",
    "vite.preload.config.ts",
    "vite.renderer.config.ts",
    "vitest.config.ts"
  ],
  "exclude": [".vite", "dist", "node_modules", "out"]
}
