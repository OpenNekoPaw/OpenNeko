{
  "name": "@neko/app-desktop",
  "version": "0.0.1",
  "description": "Canonical Electron application composition root for OpenNeko",
  "private": true,
  "type": "module",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "build": "electron-forge package",
    "dev": "electron-forge start",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "make": "electron-forge make",
    "package": "electron-forge package",
    "test": "vitest run",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neko-agent/types": "workspace:*",
    "@neko-agent/webview": "workspace:*",
    "@neko/agent": "workspace:*",
    "@neko-canvas/domain": "workspace:*",
    "@neko-canvas/webview": "workspace:*",
    "@neko-cut/domain": "workspace:*",
    "@neko-cut/node": "workspace:*",
    "@neko/webview": "workspace:*",
    "@neko/entity": "workspace:*",
    "@neko/generation": "workspace:*",
    "@neko/host": "workspace:*",
    "@neko/media": "workspace:*",
    "@neko/platform": "workspace:*",
    "@neko-preview/contracts": "workspace:*",
    "@neko/preview-webview": "workspace:*",
    "@neko/shared": "workspace:*",
    "@neko/ui": "workspace:*",
    "neko-assets": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.80.7",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@types/node": "^24.0.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.27",
    "electron": "43.2.0",
    "jsdom": "^27.0.1",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "typescript": "^5.9.3",
    "vite": "6.4.2",
    "vitest": "4.1.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "AGPL-3.0-or-later"
}
