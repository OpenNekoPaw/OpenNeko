{
  "name": "@neko/app-desktop",
  "version": "0.0.1",
  "description": "Canonical Electron application composition root for OpenNeko",
  "private": true,
  "type": "module",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "build": "node ../../scripts/assert-supported-desktop-host.mjs && electron-forge package && node ../../scripts/assert-desktop-package-output.mjs",
    "dev": "node ../../scripts/assert-supported-desktop-host.mjs && node ../../scripts/desktop-functional/run-development.mjs",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "make": "node ../../scripts/assert-supported-desktop-host.mjs && electron-forge make && node ../../scripts/assert-desktop-package-output.mjs",
    "package": "node ../../scripts/assert-supported-desktop-host.mjs && electron-forge package && node ../../scripts/assert-desktop-package-output.mjs",
    "test": "vitest run",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neko/agent-contracts": "workspace:*",
    "@neko/agent-runtime": "workspace:*",
    "@neko/agent-webview": "workspace:*",
    "@neko/automation-contracts": "workspace:*",
    "@neko/automation-node": "workspace:*",
    "@neko/automation-webview": "workspace:*",
    "@neko/assets-domain": "workspace:*",
    "@neko/assets-node": "workspace:*",
    "@neko/assets-webview": "workspace:*",
    "@neko/canvas-domain": "workspace:*",
    "@neko/canvas-node": "workspace:*",
    "@neko/canvas-webview": "workspace:*",
    "@neko/chara": "workspace:*",
    "@neko/chara-node": "workspace:*",
    "@neko/chara-webview": "workspace:*",
    "@neko/content": "workspace:*",
    "@neko/cut-domain": "workspace:*",
    "@neko/cut-node": "workspace:*",
    "@neko/cut-webview": "workspace:*",
    "@neko/entity-domain": "workspace:*",
    "@neko/entity-node": "workspace:*",
    "@neko/generation": "workspace:*",
    "@neko/host": "workspace:*",
    "@neko/local-metadata": "workspace:*",
    "@neko/media": "workspace:*",
    "@neko/preview-domain": "workspace:*",
    "@neko/preview-webview": "workspace:*",
    "@neko/shared": "workspace:*",
    "@neko/text-editor-domain": "workspace:*",
    "@neko/text-editor-node": "workspace:*",
    "@neko/text-editor-webview": "workspace:*",
    "@neko/ui": "workspace:*",
    "@neko/world-node": "workspace:*",
    "@neko/world": "workspace:*",
    "@neko/world-webview": "workspace:*",
    "@zip.js/zip.js": "^2.8.26",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.80.7",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@types/node": "^24.0.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.27",
    "electron": "43.2.0",
    "jsdom": "^27.0.1",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "typescript": "^5.9.3",
    "vite": "6.4.2",
    "vitest": "4.1.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "AGPL-3.0-or-later"
}
