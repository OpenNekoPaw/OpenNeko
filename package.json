{
  "name": "openneko-monorepo",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.29.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:ui": "turbo run build --filter=@neko/webview --filter=@neko-tools/webview --filter=@neko/preview-webview --filter=@neko-agent/webview --filter=@neko-canvas/webview",
    "build:release": "pnpm compile:ts-vsix",
    "build:dev": "pnpm --dir apps/neko-vscode compile",
    "build:vscode:dev": "node scripts/stage-openneko-dev-extension.mjs --build",
    "prepare:vscode-media-fixture": "node scripts/prepare-vscode-media-fixture.mjs",
    "validate:media-matrix": "tsx scripts/validate-node-media-matrix.mts",
    "validate:media-waveform": "tsx scripts/validate-node-media-waveform.mts",
    "build:neko-preview": "pnpm --dir packages/neko-preview-webview build",
    "build:neko-cut": "pnpm --dir packages/neko-cut-webview build",
    "build:neko-agent": "pnpm --dir packages/neko-agent-webview build",
    "compile:ts-vsix": "node scripts/compile-ts-vsix.mjs",
    "dev": "pnpm --dir packages/neko-cut-webview dev",
    "dev:neko": "pnpm --dir packages/neko-cut-webview dev",
    "lint": "eslint \"apps/neko-desktop/src/**/*.{ts,tsx}\" \"apps/neko-vscode/src/**/*.{ts,tsx}\" \"packages/**/src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"apps/neko-desktop/src/**/*.{ts,tsx}\" \"apps/neko-vscode/src/**/*.{ts,tsx}\" \"packages/**/src/**/*.{ts,tsx}\" --fix",
    "lint:turbo": "turbo run lint",
    "test": "turbo run test --concurrency=2",
    "test:coverage": "turbo run test --concurrency=2 --continue=always -- --coverage",
    "test:agent:mock": "pnpm --filter neko-agent run test:agent:mock",
    "test:agent:eval": "vitest --config vitest.agent-eval.config.mts --run && node scripts/agent-eval/all-suite-dry-run.mjs",
    "test:local:vscode": "node --test scripts/test-orchestration/vscode-debug-config.local.mjs",
    "test:local:ui": "pnpm smoke:webview:targets",
    "test:local:api": "node scripts/agent-eval/local-run.mjs",
    "package:all": "turbo run package --filter='neko-*'",
    "package:vscode": "pnpm --dir apps/neko-vscode run package",
    "clean": "turbo run clean && rm -rf .turbo node_modules/.cache",
    "generate:agent-eval:document-image-fixture": "node scripts/agent-eval/fixtures/generate-synthetic-document-image-epub.mjs",
    "nekoagent": "pnpm --filter @neko/app-tui dev",
    "format": "prettier --write \"apps/neko-vscode/src/**/*.{ts,tsx,json}\" \"packages/**/src/**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"apps/neko-vscode/src/**/*.{ts,tsx,json}\" \"packages/**/src/**/*.{ts,tsx,json}\"",
    "check:unused": "knip",
    "check:unused:fix": "knip --fix",
    "check:legacy-debt": "node scripts/check-legacy-debt-surfaces.mjs",
    "check:legacy-debt:ledger": "node scripts/check-legacy-debt-surfaces.mjs --validate-ledger",
    "check:content-access-boundaries": "node scripts/check-content-access-boundaries.mjs",
    "check:application-boundaries": "node scripts/check-application-boundaries.mjs --self-test && node scripts/check-application-boundaries.mjs",
    "check:single-extension-architecture": "node scripts/check-single-extension-architecture.mjs",
    "check:product-brand": "node scripts/check-product-brand.mjs",
    "check:agent-boundaries": "node scripts/check-neko-agent-boundaries.mjs",
    "check:canvas-playback-boundary": "node scripts/check-canvas-playback-boundary.mjs",
    "check:engine-retirement-boundary": "node scripts/check-engine-retirement-boundary.mjs",
    "check:release-channels": "node scripts/check-release-channels.mjs",
    "check:openspec": "node scripts/check-openspec.mjs",
    "check:strict-tsconfig": "node scripts/check-strict-tsconfig.mjs",
    "check:strict-agent": "pnpm --dir packages/neko-agent-runtime run typecheck",
    "check:local-metadata-runtimes": "node scripts/check-local-metadata-runtime-matrix.mjs",
    "check:strict-extensions": "pnpm --dir apps/neko-vscode typecheck",
    "check:test-orchestration": "node --test scripts/test-orchestration/*.test.mjs && node scripts/test-orchestration/audit-test-ownership.mjs && node scripts/test-orchestration/audit-coverage-config.mjs",
    "check:webview-boundaries": "node scripts/check-webview-boundaries.mjs",
    "check:quality": "pnpm check:release-channels && pnpm check:product-brand && pnpm check:legacy-debt:ledger && pnpm check:content-access-boundaries && pnpm check:application-boundaries && pnpm check:single-extension-architecture && pnpm check:agent-boundaries && pnpm check:canvas-playback-boundary && pnpm check:engine-retirement-boundary && pnpm check:webview-boundaries && pnpm check:strict-tsconfig && pnpm check:strict-agent && pnpm check:strict-extensions && pnpm check:local-metadata-runtimes && pnpm check:test-orchestration && pnpm check:openspec",
    "check:deps": "depcruise packages/neko-types/src packages/neko-host/src packages/neko-media/src packages/neko-chara/src packages/neko-generation/src packages/neko-quality/src apps/neko-vscode/src/features/cut packages/neko-cut-webview/src apps/neko-vscode/src/features/agent packages/neko-platform/src packages/neko-agent-runtime/src packages/neko-canvas-webview/src apps/neko-vscode/src/features/preview --config",
    "check": "pnpm check:unused && pnpm check:deps",
    "check:build": "pnpm format:check && pnpm lint && pnpm build",
    "check:test": "pnpm test:coverage",
    "check:repository-quality": "pnpm check && pnpm check:quality",
    "check:ci": "pnpm check:build && pnpm check:test && pnpm check:repository-quality",
    "check:fast": "pnpm lint && pnpm test -- --run",
    "gate:local": "pnpm check:build && pnpm test && pnpm check:repository-quality && pnpm test:local:vscode",
    "gate:remote": "pnpm check:ci",
    "ci:local": "pnpm gate:local",
    "ci:remote": "pnpm gate:remote",
    "ci:act": "scripts/act-ci.sh",
    "ci:act:list": "scripts/act-ci.sh --list",
    "smoke:webview": "node scripts/smoke-webview-builds.mjs",
    "smoke:vscode:targets": "node scripts/smoke-vscode-targets.mjs",
    "smoke:webview:targets": "node scripts/smoke-vscode-targets.mjs --skill vscode-extension-debugger --require-webview",
    "smoke": "pnpm smoke:webview",
    "prepare": "husky"
  },
  "lint-staged": {
    "packages/**/src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/**/src/**/*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@img/sharp-wasm32": "^0.34.5"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.80.7",
    "@eslint/js": "^9.39.4",
    "@fission-ai/openspec": "1.3.1",
    "@neko/media": "workspace:*",
    "@neko/shared": "workspace:*",
    "@vitest/coverage-v8": "4.1.2",
    "@vscode/vsce": "^3.9.2",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.1",
    "tsx": "^4.21.0",
    "turbo": "^2.10.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vite": "6.4.2",
    "vitest": "4.1.2",
    "yaml": "2.9.0"
  }
}
