{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".github/workflows/*.yml",
    ".dependency-cruiser.cjs",
    "eslint.config.mjs",
    "knip.json",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "quality/**",
    "scripts/test-orchestration/**",
    "tsconfig.json",
    "vitest.shared.ts"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"],
      "cache": true
    },
    "compile": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "watch": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": [],
      "cache": true
    },
    "test": {
      "outputs": ["coverage/**"],
      "cache": false
    },
    "package": {
      "dependsOn": ["build"],
      "outputs": ["out/**"],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
